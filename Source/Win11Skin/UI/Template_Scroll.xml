              <att.Points>
                <Point>x:4 y:0</Point>
                <Point>x:0 y:4</Point>
                <Point>x:4 y:8</Point>
              </att.Points>
            </Polygon>
          </Cell>
        </Table>
      </ButtonTemplate>
    </Instance>
