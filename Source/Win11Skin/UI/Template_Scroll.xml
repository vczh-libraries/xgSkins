<Folder>
  <Script name="TrackerGeometry">
    <Workflow><![CDATA[
    module Win11TrackerGeometry;
    using presentation::*;
    using presentation::controls::*;
    namespace win11skin
    {
      func GetTrackerThumbSize(bounds : Rect, horizontal : bool) : Size
      {
        var width = bounds.x2 - bounds.x1;
        var height = bounds.y2 - bounds.y1;
        var length = horizontal ? width : height;
        var diameter = horizontal ? height : width;
        if (diameter > 16) { diameter = 16; }
        if (diameter > length / 2) { diameter = length / 2; }
        return {x:diameter; y:diameter;};
      }

      func GetTrackerBulletMargin(bounds : Rect, state : ButtonState) : Margin
      {
        var diameter = bounds.x2 - bounds.x1;
        var inset = state == ButtonState::Pressed ? 5 : state == ButtonState::Active ? 3 : 4;
        var padding = diameter * inset / 16;
        return {left:padding; top:padding; right:padding; bottom:padding;};
      }
    }
    ]]></Workflow>
  </Script>

  <Instance name="LeftScrollButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win11skin::LeftScrollButtonTemplate" ref.Styles="res://Win11Skin/Style">
      <ref.Members><![CDATA[
        var animationBuilder : ButtonColorAnimation^ = new ButtonColorAnimation^(new ButtonColorState^(GetScrollButtonColors(true, ButtonState::Normal, true)));
        var lastAnimation : IGuiAnimation^ = null;

        func UpdateColors() : void
        {
          KillAnimation(lastAnimation);
          lastAnimation = CompleteColorAnimation(animationBuilder.CreateAnimation(new ButtonColorState^(GetScrollButtonColors(self.VisuallyEnabled, self.State, true)), cast UInt64 120), func():void { animationBuilder.Interpolate(1.0); });
          AddAnimation(lastAnimation);
        }
      ]]></ref.Members>
      <ButtonTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren">
        <ev.StateChanged-eval>self.UpdateColors();</ev.StateChanged-eval>
        <ev.VisuallyEnabledChanged-eval>self.UpdateColors();</ev.VisuallyEnabledChanged-eval>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0" Visible-bind="self.animationBuilder.Current.BorderProgress &gt; 0.0">
          <SolidBorder Color-bind="self.animationBuilder.Current.Border" Shape="shapeType:RoundRect radiusX:4 radiusY:4"/>
        </Bounds>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1" Visible-bind="self.animationBuilder.Current.BackgroundProgress &gt; 0.0">
          <SolidBackground Color-bind="self.animationBuilder.Current.Face" Shape="shapeType:RoundRect radiusX:3 radiusY:3"/>
        </Bounds>
        <Table AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <att.Rows>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
            <CellOption>composeType:Absolute absolute:9</CellOption>
