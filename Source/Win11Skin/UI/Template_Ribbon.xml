  <Instance name="RibbonGalleryDropdownButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win11skin::RibbonGalleryDropdownButtonTemplate" ref.Styles="res://Win11Skin/Style">
      <ref.Members><![CDATA[
        prop Colors : ButtonColors = GetScrollButtonColors(true, ButtonState::Normal, true) {}
        var animation : ButtonColorAnimation^ = new ButtonColorAnimation^(new ButtonColorState^(GetScrollButtonColors(true, ButtonState::Normal, true)));
        var lastAnimation : IGuiAnimation^ = null;
      ]]></ref.Members>
      <ButtonTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren">
        <att.Colors-bind>GetScrollButtonColors(self.VisuallyEnabled, self.State, true)</att.Colors-bind>
        <ev.ColorsChanged-eval><![CDATA[{
          self.KillAnimation(self.lastAnimation);
          self.lastAnimation = CompleteColorAnimation(self.animation.CreateAnimation(new ButtonColorState^(self.Colors), cast UInt64 120), func():void { self.animation.Interpolate(1.0); });
          self.AddAnimation(self.lastAnimation);
        }]]></ev.ColorsChanged-eval>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0"><SolidBorder Color-bind="self.animation.Current.Border" Shape="shapeType:RoundRect radiusX:4 radiusY:4"/></Bounds>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
          <SolidBackground Color-bind="self.animation.Current.Face" Shape="shapeType:RoundRect radiusX:3 radiusY:3"/>
        </Bounds>
        <Table AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <att.Rows>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
            <CellOption>composeType:Absolute absolute:1</CellOption>
            <CellOption>composeType:Absolute absolute:2</CellOption>
            <CellOption>composeType:Absolute absolute:5</CellOption>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
          </att.Rows>
          <att.Columns>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
            <CellOption>composeType:Absolute absolute:9</CellOption>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
          </att.Columns>

          <Cell Site="row:1 column:1">
            <SolidBackground Color-bind="self.animation.Current.Text"/>
          </Cell>

          <Cell Site="row:3 column:1">
            <Polygon BorderColor-bind="self.animation.Current.Text" BackgroundColor-bind="self.animation.Current.Text" Size="x:9 y:5">
              <att.Points>
                <Point>x:0 y:0</Point>
                <Point>x:4 y:4</Point>
                <Point>x:8 y:0</Point>
              </att.Points>
            </Polygon>
          </Cell>
        </Table>
      </ButtonTemplate>
    </Instance>
  </Instance>
