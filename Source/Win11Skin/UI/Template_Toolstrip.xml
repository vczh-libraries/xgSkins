  <Instance name="ToolstripButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win11skin::ToolstripButtonTemplate" ref.Styles="res://Win11Skin/Style">
      <ref.Members><![CDATA[
        prop Colors : ButtonColors = win11Colors.SubtleNormal {}
        var animation : ButtonColorAnimation^ = new ButtonColorAnimation^(new ButtonColorState^(win11Colors.SubtleNormal));
        var lastAnimation : IGuiAnimation^ = null;
      ]]></ref.Members>
      <ToolstripButtonTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.Colors-bind>not self.VisuallyEnabled ? win11Colors.SubtleDisabled : self.State == ButtonState::Pressed or self.SubMenuOpening ? win11Colors.SubtlePressed : self.Selected ? win11Colors.SubtleSelected : self.State == ButtonState::Active ? win11Colors.SubtleHovered : win11Colors.SubtleNormal</att.Colors-bind>
        <ev.ColorsChanged-eval><![CDATA[{
          self.KillAnimation(self.lastAnimation);
          self.lastAnimation = CompleteColorAnimation(self.animation.CreateAnimation(new ButtonColorState^(self.Colors), cast UInt64 120), func():void { self.animation.Interpolate(1.0); });
          self.AddAnimation(self.lastAnimation);
        }]]></ev.ColorsChanged-eval>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0"><SolidBorder Color-bind="self.animation.Current.Border" Shape="shapeType:RoundRect radiusX:4 radiusY:4"/></Bounds>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
          <SolidBackground Color-bind="self.animation.Current.Face" Shape="shapeType:RoundRect radiusX:3 radiusY:3"/>
        </Bounds>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">

          <Bounds ref.Name ="container" AlignmentToParent="left:3 top:3 right:3 bottom:3">
            <ImageFrame Image-bind="self.Image.Image ?? null" FrameIndex-bind="self.Image.FrameIndex ?? 0" Enabled-bind="self.VisuallyEnabled"/>
          </Bounds>
        </Bounds>
      </ToolstripButtonTemplate>
    </Instance>
  </Instance>

