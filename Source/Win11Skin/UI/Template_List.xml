  <Instance name="ComboBoxTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win11skin::ComboBoxTemplate" ref.Styles="res://Win11Skin/Style">
      <ref.Members><![CDATA[
        prop Colors : ButtonColors = win11Colors.ButtonNormal {}
        var animationBuilder : ButtonColorAnimation^ = new ButtonColorAnimation^(new ButtonColorState^(win11Colors.ButtonNormal));
        var lastAnimation : IGuiAnimation^ = null;
        func UpdateColors() : void
        {
          KillAnimation(lastAnimation);
          lastAnimation = CompleteColorAnimation(animationBuilder.CreateAnimation(new ButtonColorState^(self.Colors), cast UInt64 120), func():void { animationBuilder.Interpolate(1.0); });
          AddAnimation(lastAnimation);
        }
      ]]></ref.Members>
      <DateComboBoxTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.DatePickerTemplate>win11skin::DatePickerTemplate</att.DatePickerTemplate>
        <att.Colors-bind>GetButtonColors(self.VisuallyEnabled, self.SubMenuOpening ? ButtonState::Pressed : self.State)</att.Colors-bind>
        <ev.ColorsChanged-eval>self.UpdateColors();</ev.ColorsChanged-eval>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <SolidBorder Color-bind="self.animationBuilder.Current.Border" Shape="shapeType:RoundRect radiusX:4 radiusY:4"/>
        </Bounds>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
          <SolidBackground Color-bind="self.animationBuilder.Current.Face" Shape="shapeType:RoundRect radiusX:3 radiusY:3"/>
        </Bounds>
        <Bounds AlignmentToParent="left:4 top:-1 right:4 bottom:0" PreferredMinSize="y:1" Visible-bind="self.VisuallyEnabled and self.State != ButtonState::Pressed and not self.SubMenuOpening">
          <SolidBackground Color-eval="win11Colors.ButtonBottomStroke"/>
        </Bounds>
        <Bounds AlignmentToParent="left:2 top:2 right:11 bottom:2" Visible-bind="self.Focused"><SolidBorder Color-eval="win11Colors.Foreground" Shape="shapeType:RoundRect radiusX:3 radiusY:3"/></Bounds>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <Bounds ref.Name="container" AlignmentToParent="left:1 top:1 right:11 bottom:1">
            <Bounds AlignmentToParent="left:2 top:2 right:2 bottom:2" Visible-bind="self.TextVisible">
              <SolidLabel Color-bind="self.animationBuilder.Current.Text" Text-bind="self.Text" Font-bind="self.Font" Ellipse="true" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Bounds>
          </Bounds>

          <Table AlignmentToParent="left:-1 top:1 right:2 bottom:1" PreferredMinSize="x:9 y:3" MinSizeLimitation="NoLimit">
            <att.Rows>
              <CellOption>composeType:Percentage percentage:0.5</CellOption>
              <CellOption>composeType:Absolute absolute:6</CellOption>
              <CellOption>composeType:Percentage percentage:0.5</CellOption>
            </att.Rows>
            <att.Columns>
              <CellOption>composeType:Percentage percentage:0.5</CellOption>
              <CellOption>composeType:Absolute absolute:9</CellOption>
              <CellOption>composeType:Percentage percentage:0.5</CellOption>
            </att.Columns>

            <Cell Site="row:1 column:1">
              <Polygon BorderColor-bind="self.animationBuilder.Current.Text" BackgroundColor-bind="self.animationBuilder.Current.Text" Size="x:9 y:6">
                <att.Points>
                  <Point>x:0 y:0</Point>
                  <Point>x:4 y:4</Point>
                  <Point>x:8 y:0</Point>
                  <Point>x:8 y:1</Point>
                  <Point>x:4 y:5</Point>
                  <Point>x:0 y:1</Point>
                </att.Points>
              </Polygon>
            </Cell>
          </Table>
        </Bounds>
      </DateComboBoxTemplate>
    </Instance>
  </Instance>

  <Instance name="ListViewColumnHeaderTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win11skin::ListViewColumnHeaderTemplate" ref.Styles="res://Win11Skin/Style">
      <ListViewColumnHeaderTemplate ref.Name="self" ContainerComposition-ref="container" SubMenuHost-ref="buttonArrow" MinSizeLimitation="LimitToElementAndChildren">
        <SolidBackground Color-bind="not self.VisuallyEnabled ? win11Colors.Layer : self.State == ButtonState::Pressed ? win11Colors.SubtlePressed.Face : self.State == ButtonState::Active ? win11Colors.SubtleHovered.Face : win11Colors.Layer" Shape="shapeType:RoundRect radiusX:4 radiusY:4"/>
        <Bounds AlignmentToParent="left:-1 top:3 right:0 bottom:3" PreferredMinSize="x:1 y:0">
          <SolidBackground Color-eval="win11Colors.Stroke"/>
        </Bounds>
        <Bounds ref.Name="container" AlignmentToParent="left:1 top:1 right:11 bottom:1">
          <Table AlignmentToParent="left:0 top:1 right:0 bottom:-1">
            <att.Rows>
              <_>composeType:MinSize</_>
              <_>composeType:Percentage percentage:1.0</_>
            </att.Rows>
            <att.Columns>
              <_>composeType:Percentage percentage:0.5</_>
              <_>composeType:MinSize</_>
              <_>composeType:Percentage percentage:0.5</_>
            </att.Columns>

            <Cell Site="row:0 column:1">
              <Bounds Visible-bind="self.SortingState == ColumnSortingState::Ascending">
                <Polygon BorderColor-eval="win11Colors.Secondary" BackgroundColor-eval="win11Colors.Secondary" Size="x:7 y:4">
                  <att.Points>
                    <Point>x:0 y:3</Point>
                    <Point>x:3 y:0</Point>
                    <Point>x:6 y:3</Point>
                  </att.Points>
                </Polygon>
              </Bounds>
              <Bounds Visible-bind="self.SortingState == ColumnSortingState::Descending">
                <Polygon BorderColor-eval="win11Colors.Secondary" BackgroundColor-eval="win11Colors.Secondary" Size="x:7 y:4">
                  <att.Points>
                    <Point>x:0 y:0</Point>
                    <Point>x:3 y:3</Point>
                    <Point>x:6 y:0</Point>
                  </att.Points>
                </Polygon>
              </Bounds>
            </Cell>
          </Table>
          <Bounds AlignmentToParent="left:8 top:6 right:5 bottom:5">
            <SolidLabel Color-bind="self.VisuallyEnabled ? win11Colors.Secondary : win11Colors.Disabled" Text-bind="self.Text" Font-bind="self.Font" Ellipse="true" HorizontalAlignment="Left" VerticalAlignment="Center"/>
          </Bounds>
        </Bounds>
        <Bounds AlignmentToParent="left:-1 top:0 right:0 bottom:0">
          <CheckBox ref.Name="buttonArrow" AutoFocus="false" AutoSelection="false" ControlTemplate="win11skin::ListViewColumnDropDownTemplate" Selected-bind="self.SubMenuOpening" Visible-bind="self.SubMenuExisting and (self.SubMenuOpening or self.State != ButtonState::Normal)">
            <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
          </CheckBox>
        </Bounds>
      </ListViewColumnHeaderTemplate>
    </Instance>
  </Instance>

