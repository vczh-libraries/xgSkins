<Folder>
  <Instance name="ItemBackgroundTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win11skin::ItemBackgroundTemplate" ref.Styles="res://Win11Skin/Style">
      <ref.Members><![CDATA[
        prop Colors : ButtonColors = win11Colors.SubtleNormal {}
        prop ShowIndicator : bool = true {}
      ]]></ref.Members>
      <SelectableButtonTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.Colors-bind>not self.VisuallyEnabled ? win11Colors.SubtleDisabled : self.Selected
          ? (self.State == ButtonState::Active ? win11Colors.SubtlePressed : win11Colors.SubtleSelected)
          : self.State == ButtonState::Pressed ? win11Colors.SubtlePressed : self.State == ButtonState::Active ? win11Colors.SubtleHovered : win11Colors.SubtleNormal</att.Colors-bind>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <SolidBorder Color-bind="self.Colors.Border" Shape="shapeType:RoundRect radiusX:4 radiusY:4"/>
        </Bounds>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0" MinSizeLimitation="NoLimit">
          <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
            <SolidBackground Color-bind="self.Colors.Face" Shape="shapeType:RoundRect radiusX:3 radiusY:3"/>
          </Bounds>
        </Bounds>
        <SideAligned Direction="Left" MaxLength="3" Visible-bind="self.ShowIndicator and self.VisuallyEnabled and self.Selected">
          <Table AlignmentToParent="left:0 top:0 right:0 bottom:0">
            <att.Rows><_>composeType:Percentage percentage:1.0</_><_>composeType:Absolute absolute:12</_><_>composeType:Percentage percentage:1.0</_></att.Rows>
            <att.Columns><_>composeType:Percentage percentage:1.0</_></att.Columns>
            <Cell Site="row:1 column:0"><SolidBackground Color-eval="win11Colors.Accent" Shape="shapeType:RoundRect radiusX:2 radiusY:2"/></Cell>
          </Table>
        </SideAligned>
        <Bounds ref.Name="container" AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
      </SelectableButtonTemplate>
    </Instance>
  </Instance>

