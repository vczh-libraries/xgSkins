  <Instance name="ToolstripButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::ToolstripButtonTemplate" ref.Styles="res://UbuntuSkin/Style">
      <ref.Members><![CDATA[
        prop Colors : ButtonColors = ubuntuColors.CommandNormal {}
        var animation : ButtonColorAnimation^ = new ButtonColorAnimation^(new ButtonColorState^(ubuntuColors.CommandNormal));
        var lastAnimation : IGuiAnimation^ = null;
      ]]></ref.Members>
      <ToolstripButtonTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.Colors-bind>GetCommandColors(self.VisuallyEnabled, self.State, self.Selected, self.SubMenuOpening)</att.Colors-bind>
        <ev.ColorsChanged-eval><![CDATA[{
          self.KillAnimation(self.lastAnimation);
          self.lastAnimation = CompleteColorAnimation(self.animation.CreateAnimation(new ButtonColorState^(self.Colors), cast UInt64 150), func():void { self.animation.Interpolate(1.0); });
          self.AddAnimation(self.lastAnimation);
        }]]></ev.ColorsChanged-eval>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0"><SolidBorder Color-bind="self.animation.Current.Border"/></Bounds>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
          <GradientBackground Direction="Vertical" Color1-bind="self.animation.Current.G1" Color2-bind="self.animation.Current.G2"/>
        </Bounds>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">

          <Bounds ref.Name ="container" AlignmentToParent="left:3 top:3 right:3 bottom:3">
            <ImageFrame Image-bind="self.Image.Image ?? null" FrameIndex-bind="self.Image.FrameIndex ?? 0" Enabled-bind="self.VisuallyEnabled"/>
          </Bounds>
        </Bounds>
      </ToolstripButtonTemplate>
    </Instance>
  </Instance>

  <Instance name="ToolstripDropdownButtonResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::ToolstripDropdownButtonTemplate" ref.Styles="res://UbuntuSkin/Style">
      <ref.Members><![CDATA[
        prop Colors : ButtonColors = ubuntuColors.CommandNormal {}
        var animation : ButtonColorAnimation^ = new ButtonColorAnimation^(new ButtonColorState^(ubuntuColors.CommandNormal));
        var lastAnimation : IGuiAnimation^ = null;
      ]]></ref.Members>
      <ToolstripButtonTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.Colors-bind>GetCommandColors(self.VisuallyEnabled, self.State, self.Selected, self.SubMenuOpening)</att.Colors-bind>
        <ev.ColorsChanged-eval><![CDATA[{
          self.KillAnimation(self.lastAnimation);
          self.lastAnimation = CompleteColorAnimation(self.animation.CreateAnimation(new ButtonColorState^(self.Colors), cast UInt64 150), func():void { self.animation.Interpolate(1.0); });
          self.AddAnimation(self.lastAnimation);
        }]]></ev.ColorsChanged-eval>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0"><SolidBorder Color-bind="self.animation.Current.Border"/></Bounds>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
          <GradientBackground Direction="Vertical" Color1-bind="self.animation.Current.G1" Color2-bind="self.animation.Current.G2"/>
        </Bounds>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">

          <Bounds AlignmentToParent="left:0 top:0 right:10 bottom:0">
            <Bounds ref.Name ="container" AlignmentToParent="left:3 top:3 right:3 bottom:3">
              <ImageFrame Image-bind="self.Image.Image ?? null" FrameIndex-bind="self.Image.FrameIndex ?? 0" Enabled-bind="self.VisuallyEnabled"/>
            </Bounds>
          </Bounds>
          <Table AlignmentToParent="left:-1 top:0 right:0 bottom:0" PreferredMinSize="x:9 y:0">
            <att.Rows>
              <CellOption>composeType:Percentage percentage:0.5</CellOption>
              <CellOption>composeType:Absolute absolute:3</CellOption>
              <CellOption>composeType:Percentage percentage:0.5</CellOption>
            </att.Rows>
            <att.Columns>
              <CellOption>composeType:Percentage percentage:0.5</CellOption>
              <CellOption>composeType:Absolute absolute:5</CellOption>
              <CellOption>composeType:Percentage percentage:0.5</CellOption>
            </att.Columns>

            <Cell Site="row:1 column:1">
              <Polygon ref.Style="toolstripArrow" Size="x:5 y:3">
                <att.Points>
                  <Point>x:0 y:0</Point>
                  <Point>x:2 y:2</Point>
                  <Point>x:4 y:0</Point>
                </att.Points>
              </Polygon>
            </Cell>
          </Table>
        </Bounds>
      </ToolstripButtonTemplate>
    </Instance>
  </Instance>

  <Instance name="ToolstripArrowButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::ToolstripSplitArrowTemplate" ref.Styles="res://UbuntuSkin/Style">
      <SelectableButtonTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren" PreferredMinSize="x:13 y:7">
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1" Visible-bind="self.VisuallyEnabled and self.State != ButtonState::Normal">
          <SolidBackground Color-bind="self.State == ButtonState::Pressed ? ubuntuColors.CommandPressed.G1 : ubuntuColors.CommandHovered.G1"/>
        </Bounds>
        <Bounds AlignmentToParent="left:0 top:1 right:-1 bottom:1" PreferredMinSize="x:1 y:0" Visible-bind="self.VisuallyEnabled and (self.Selected or self.State != ButtonState::Normal)">
          <SolidBackground Color-eval="ubuntuColors.CommandHovered.Border"/>
        </Bounds>
        <Table AlignmentToParent="left:4 top:0 right:4 bottom:0">
          <att.Rows>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
            <CellOption>composeType:Absolute absolute:3</CellOption>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
          </att.Rows>
          <att.Columns><CellOption>composeType:Absolute absolute:5</CellOption></att.Columns>
          <Cell Site="row:1 column:0">
            <Polygon ref.Style="toolstripSplitArrow" Size="x:5 y:3">
              <att.Points>
                <Point>x:0 y:0</Point>
                <Point>x:2 y:2</Point>
                <Point>x:4 y:0</Point>
              </att.Points>
            </Polygon>
          </Cell>
        </Table>
      </SelectableButtonTemplate>
    </Instance>
  </Instance>

