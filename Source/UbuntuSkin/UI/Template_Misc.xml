<Folder>
  <Script name="GroupCaptionState">
    <Workflow><![CDATA[
      module UbuntuGroupCaption;
      using presentation::*;
      namespace ubuntuskin
      {
        class GroupCaptionState
        {
          prop Text : Color = {} {}
          new() {}
          new(color : Color) { Text = color; }
        }
      }
    ]]></Workflow>
  </Script>
  <Animation name="GroupCaptionAnimation">
    <Gradient ref.Class="ubuntuskin::GroupCaptionAnimation" Type="ubuntuskin::GroupCaptionState">
      <Interpolation><![CDATA[[$1]]]></Interpolation>
      <Targets><Target Name="Text"/></Targets>
    </Gradient>
  </Animation>
  <Instance name="GroupBoxTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::GroupBoxTemplate" ref.Styles="res://UbuntuSkin/Style">
      <ref.Members><![CDATA[
        prop CaptionColor : Color = ubuntuColors.Ink {}
        var animation : GroupCaptionAnimation^ = new GroupCaptionAnimation^(new GroupCaptionState^(ubuntuColors.Ink));
        var lastAnimation : IGuiAnimation^ = null;
      ]]></ref.Members>
      <ControlTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.CaptionColor-bind>self.VisuallyEnabled ? ubuntuColors.Ink : ubuntuColors.DisabledInk</att.CaptionColor-bind>
        <ev.CaptionColorChanged-eval><![CDATA[{
          self.KillAnimation(self.lastAnimation);
          self.lastAnimation = CompleteColorAnimation(self.animation.CreateAnimation(new GroupCaptionState^(self.CaptionColor), cast UInt64 150), func():void { self.animation.Interpolate(1.0); });
          self.AddAnimation(self.lastAnimation);
        }]]></ev.CaptionColorChanged-eval>
        <Bounds AlignmentToParent-bind="{left:0 top:(titleBounds.CachedBounds.y2/2) right:0 bottom:0}">
          <!-- Leave the caption gap open so the parent surface shows through. -->
          <Bounds AlignmentToParent="left:0 top:1 right:0 bottom:0">
            <Bounds AlignmentToParent="left:0 top:-2 right:0 bottom:0">
              <SolidBorder Color-eval="ubuntuColors.Divider"/>
            </Bounds>
          </Bounds>
          <Bounds AlignmentToParent="left:0 top:0 right:-1 bottom:-1" PreferredMinSize="x:5 y:1">
            <SolidBackground Color-eval="ubuntuColors.Divider"/>
          </Bounds>
          <Bounds AlignmentToParent-bind="{left:titleBounds.CachedBounds.x2 top:0 right:0 bottom:-1}" PreferredMinSize="y:1">
            <SolidBackground Color-eval="ubuntuColors.Divider"/>
          </Bounds>
          <Bounds ref.Name="container" AlignmentToParent-bind="{left:1 top:(1+titleBounds.CachedBounds.y2/2) right:1 bottom:1}"/>
        </Bounds>
        <Bounds ref.Name="titleBounds" AlignmentToParent="left:5 top:0 right:-1 bottom:-1">
          <Bounds AlignmentToParent="left:2 top:0 right:2 bottom:0">
            <SolidLabel Text-bind="self.Text" Color-bind="self.animation.Current.Text" Font-bind="self.Font" VerticalAlignment="Center"/>
          </Bounds>
        </Bounds>
      </ControlTemplate>
    </Instance>
  </Instance>

  <Instance name="LabelTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::LabelTemplate" ref.Styles="res://UbuntuSkin/Style">
      <ref.Members><![CDATA[prop InTooltip : bool = false {}]]></ref.Members>
      <LabelTemplate ref.Name="self" ref.Style="labelDefaultText" MinSizeLimitation="LimitToElementAndChildren">
        <ev.renderTargetChanged-eval>self.InTooltip = FindWindowTemplate(self) is (ubuntuskin::TooltipTemplate*);</ev.renderTargetChanged-eval>
        <SolidLabel Text-bind="self.Text" Font-bind="self.Font" ref.Style="labelText"/>
      </LabelTemplate>
    </Instance>
  </Instance>

  <Instance name="ShortcutKeyTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::ShortcutKeyTemplate" ref.Styles="res://UbuntuSkin/Style">
      <LabelTemplate ref.Name="self" ref.Style="labelDefaultText" MinSizeLimitation="LimitToElementAndChildren">
        <SolidBackground Color-eval="ubuntuColors.KeytipBackground"/>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">

          <Bounds AlignmentToParent="left:3 top:1 right:3 bottom:1">
            <SolidLabel Text-bind="self.Text" Font-bind="self.Font" Color-eval="ubuntuColors.KeytipText"/>
          </Bounds>
        </Bounds>
      </LabelTemplate>
    </Instance>
  </Instance>

  <Instance name="DateButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::DateButtonTemplate" ref.Styles="res://UbuntuSkin/Style">
      <SelectableButtonTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
          <SolidBackground Color-bind="self.Selected ? ubuntuColors.SelectedSurface : self.State == ButtonState::Pressed ? ubuntuColors.PressedSurface : self.State == ButtonState::Active ? ubuntuColors.HoverSurface : ubuntuColors.Clear"/>
        </Bounds>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1" Visible-bind="self.Focused or self.Selected">
          <SolidBorder Color-bind="self.Focused ? ubuntuColors.Focus : ubuntuColors.Accent"/>
        </Bounds>
        <Bounds ref.Name="container" AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
      </SelectableButtonTemplate>
    </Instance>
  </Instance>

  <Instance name="DatePickerTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::DatePickerTemplate" ref.Styles="res://UbuntuSkin/Style">
      <DatePickerTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren" Date-bind="look.Date">
        <CommonDatePickerLook ref.Name="look" ref.Style="datePickerColors" AlignmentToParent="left:0 top:0 right:0 bottom:0" Font-bind="self.Font" Date-bind="self.Date" DateLocale-bind="self.DateLocale" Commands-bind="self.Commands">
          <att.DateButtonTemplate>ubuntuskin::DateButtonTemplate</att.DateButtonTemplate>
          <att.DateTextListTemplate>ubuntuskin::TextListTemplate</att.DateTextListTemplate>
          <att.DateComboBoxTemplate>ubuntuskin::ComboBoxTemplate</att.DateComboBoxTemplate>
        </CommonDatePickerLook>
      </DatePickerTemplate>
    </Instance>
  </Instance>
</Folder>
