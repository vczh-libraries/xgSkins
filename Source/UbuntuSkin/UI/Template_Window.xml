<Folder>
  <Instance name="CustomControlTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::CustomControlTemplate" ref.Styles="res://UbuntuSkin/Style">
      <ControlTemplate MinSizeLimitation="LimitToElementAndChildren"/>
    </Instance>
  </Instance>

  <Instance name="TooltipTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::TooltipTemplate" ref.Styles="res://UbuntuSkin/Style">
      <WindowTemplate ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <SolidBackground Color-eval="ubuntuColors.KeytipBackground"/>
        <Bounds ref.Name="container" AlignmentToParent="left:1 top:1 right:1 bottom:1"/>
      </WindowTemplate>
    </Instance>
  </Instance>

  <Instance name="SystemFrameWindowTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::SystemFrameWindowTemplate" ref.Styles="res://UbuntuSkin/Style">
      <WindowTemplate ContainerComposition-ref="container" CustomFrameEnabled="false" MinSizeLimitation="LimitToElementAndChildren">
        <SolidBackground ref.Style="generalBackground"/>
        <Bounds ref.Name="container" AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
      </WindowTemplate>
    </Instance>
  </Instance>

  <Instance name="CustomFrameWindowTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::CustomFrameWindowTemplate" ref.Styles="res://UbuntuSkin/Style">
      <ref.Members><![CDATA[prop MaximizeGlyph : Color = ubuntuColors.HeaderInk {}]]></ref.Members>
      <WindowTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.MaximizeGlyph-bind>self.VisuallyEnabled and self.Activated and self.MaximizedBox ? ubuntuColors.HeaderInk : ubuntuColors.InactiveHeaderInk</att.MaximizeGlyph-bind>
        <att.CustomFrameEnabled>true</att.CustomFrameEnabled>
        <att.TooltipTemplate>ubuntuskin::TooltipTemplate</att.TooltipTemplate>

        <ev.TitleBarChanged-eval>
          <![CDATA[
            {
              if (self.TitleBar)
              {
                contentTable.SetRowOption(0, {composeType:MinSize});
              }
              else
              {
                contentTable.SetRowOption(0, {composeType:Absolute absolute:0});
              }
            }
          ]]>
        </ev.TitleBarChanged-eval>

        <ev.CustomFramePaddingChanged-eval>
          <![CDATA[
            {
              var padding = self.CustomFramePadding;
              var margin = {left:(padding.left > 0 ? 9 : 0); top:padding.top;
                            right:(padding.right > 0 ? 9 : 0); bottom:(padding.bottom > 0 ? 9 : 0);} of Margin;
              var captionRight = padding.right > 0 ? 4 : 0;
              contentTable.AlignmentToParent = {left:margin.left; top:margin.top; right:captionRight; bottom:margin.bottom;};
              container.AlignmentToParent = {left:0; top:0; right:margin.right - captionRight; bottom:0;};
              frameTable.SetRowOption(0, {composeType:Absolute absolute:margin.top});
              frameTable.SetRowOption(2, {composeType:Absolute absolute:margin.bottom});
              frameTable.SetColumnOption(0, {composeType:Absolute absolute:margin.left});
              frameTable.SetColumnOption(2, {composeType:Absolute absolute:margin.right});
            }
          ]]>
        </ev.CustomFramePaddingChanged-eval>

        <SolidBackground Color-bind="self.VisuallyEnabled and self.Activated ? ubuntuColors.HeaderBackground : ubuntuColors.InactiveHeaderBackground"/>
        <Bounds AlignmentToParent-bind="{left:1 top:(self.CustomFramePadding.top + clientCell.CachedBounds.y1 - 1) right:1 bottom:-1}" PreferredMinSize="y:1" Visible-bind="self.TitleBar">
          <SolidBackground Color-eval="ubuntuColors.FrameBorder"/>
        </Bounds>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0" Visible-bind="let margin = self.CustomFramePadding in (self.Border and margin.left + margin.top + margin.right + margin.bottom != 0)">
            <SolidBorder ref.Style="windowBorder"/>
          </Bounds>

          <Bounds AlignmentToParent-bind="{left:(self.CustomFramePadding.left &gt; 0 ? 4 : 0) top:(self.CustomFramePadding.top + clientCell.CachedBounds.y1)
                                          right:(self.CustomFramePadding.right &gt; 0 ? 4 : 0) bottom:(self.CustomFramePadding.bottom &gt; 0 ? 4 : 0)}">
            <SolidBackground ref.Style="generalBackground"/>
          </Bounds>

          <Table ref.Name="frameTable" AlignmentToParent="left:0 top:0 right:0 bottom:0">
            <att.Rows>
              <CellOption>composeType:Absolute absolute:0</CellOption>
              <CellOption>composeType:Percentage percentage:1.0</CellOption>
              <CellOption>composeType:Absolute absolute:0</CellOption>
            </att.Rows>
            <att.Columns>
              <CellOption>composeType:Absolute absolute:0</CellOption>
              <CellOption>composeType:Percentage percentage:1.0</CellOption>
              <CellOption>composeType:Absolute absolute:0</CellOption>
            </att.Columns>

            <Cell Site="row:0 column:0" AssociatedHitTestResult="BorderLeftTop"/>
            <Cell Site="row:0 column:2" AssociatedHitTestResult="BorderRightTop"/>
            <Cell Site="row:2 column:0" AssociatedHitTestResult="BorderLeftBottom"/>
            <Cell Site="row:2 column:2" AssociatedHitTestResult="BorderRightBottom"/>

            <Cell Site="row:1 column:0" AssociatedHitTestResult="BorderLeft"/>
            <Cell Site="row:1 column:2" AssociatedHitTestResult="BorderRight"/>
            <Cell Site="row:0 column:1" AssociatedHitTestResult="BorderTop"/>
            <Cell Site="row:2 column:1" AssociatedHitTestResult="BorderBottom"/>
          </Table>

          <Table ref.Name="contentTable" AlignmentToParent="left:0 top:0 right:0 bottom:0">
            <att.Rows>
              <CellOption>composeType:MinSize</CellOption>
              <CellOption>composeType:Percentage percentage:1.0</CellOption>
            </att.Rows>
            <att.Columns>
              <CellOption>composeType:MinSize</CellOption>
              <CellOption>composeType:Percentage percentage:1.0</CellOption>
              <CellOption>composeType:MinSize</CellOption>
              <CellOption>composeType:MinSize</CellOption>
              <CellOption>composeType:MinSize</CellOption>
            </att.Columns>

            <Cell Site="row:0 column:2">
              <att.AssociatedHitTestResult-bind>self.MinimizedBox ? ButtonMinimum : NoDecision</att.AssociatedHitTestResult-bind>
              <Button AutoFocus="false" Context-bind="self.Activated" ControlTemplate="ubuntuskin::CaptionButtonTemplate">
                <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
                <att.Enabled-bind>self.MinimizedBox</att.Enabled-bind>
                <att.Visible-bind>self.MinimizedBox or self.MaximizedBox</att.Visible-bind>
                <att.ContainerComposition-set>
                  <BoundsComposition AlignmentToParent="left:0 top:0 right:0 bottom:0" PreferredMinSize="x:24 y:24" MinSizeLimitation="LimitToElement">
                    <Polygon BorderColor-bind="self.VisuallyEnabled and self.Activated and self.MinimizedBox ? ubuntuColors.HeaderInk : ubuntuColors.InactiveHeaderInk" BackgroundColor-bind="self.VisuallyEnabled and self.Activated and self.MinimizedBox ? ubuntuColors.HeaderInk : ubuntuColors.InactiveHeaderInk" Size="x:24 y:16">
                      <att.Points>
                        <Point>x:8 y:10</Point><Point>x:15 y:10</Point>
                        <Point>x:15 y:11</Point><Point>x:8 y:11</Point>
                      </att.Points>
                    </Polygon>
                  </BoundsComposition>
                </att.ContainerComposition-set>
              </Button>
            </Cell>
            <Cell Site="row:0 column:3">
              <att.AssociatedHitTestResult-bind>self.MaximizedBox ? ButtonMaximum : NoDecision</att.AssociatedHitTestResult-bind>
              <Button AutoFocus="false" Context-bind="self.Activated" ControlTemplate="ubuntuskin::CaptionButtonTemplate">
                <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
                <att.Enabled-bind>self.MaximizedBox</att.Enabled-bind>
                <att.Visible-bind>self.MinimizedBox or self.MaximizedBox</att.Visible-bind>
                <att.ContainerComposition-set>
                  <BoundsComposition Visible-bind="not self.Maximized" AlignmentToParent="left:0 top:0 right:0 bottom:0" PreferredMinSize="x:24 y:24" MinSizeLimitation="LimitToElement">
                    <PartialView WidthRatio="0.5" WidthPageSize="0" HeightRatio="0.5" HeightPageSize="0" PreferredMinSize="x:8 y:8">
                      <SolidBorder Color-bind="self.MaximizeGlyph"/>
                    </PartialView>
                  </BoundsComposition>
                  <BoundsComposition Visible-bind="self.Maximized" AlignmentToParent="left:0 top:0 right:0 bottom:0" PreferredMinSize="x:24 y:24" MinSizeLimitation="LimitToElement">
                    <PartialView WidthRatio="0.5" WidthPageSize="0" HeightRatio="0.5" HeightPageSize="0" PreferredMinSize="x:10 y:10">
                      <!-- Draw the exposed edges of the rear window around the front outline. -->
                      <Bounds ExpectedBounds="x1:3 y1:0 x2:10 y2:1"><SolidBackground Color-bind="self.MaximizeGlyph"/></Bounds>
                      <Bounds ExpectedBounds="x1:9 y1:1 x2:10 y2:7"><SolidBackground Color-bind="self.MaximizeGlyph"/></Bounds>
                      <Bounds ExpectedBounds="x1:3 y1:1 x2:4 y2:3"><SolidBackground Color-bind="self.MaximizeGlyph"/></Bounds>
                      <Bounds ExpectedBounds="x1:7 y1:6 x2:9 y2:7"><SolidBackground Color-bind="self.MaximizeGlyph"/></Bounds>
                      <Bounds AlignmentToParent="left:0 top:3 right:3 bottom:0"><SolidBorder Color-bind="self.MaximizeGlyph"/></Bounds>
                    </PartialView>
                  </BoundsComposition>
                </att.ContainerComposition-set>
              </Button>
            </Cell>
            <Cell Site="row:0 column:4" AssociatedHitTestResult="ButtonClose">
              <Button AutoFocus="false" Context-bind="self.Activated" ControlTemplate="ubuntuskin::CaptionCloseButtonTemplate">
                <att.BoundsComposition-set AlignmentToParent="left:4 top:0 right:0 bottom:0"/>
              </Button>
            </Cell>

            <Cell Site="row:0 column:0" MinSizeLimitation-bind="((self.Icon is not null) and self.IconVisible ? LimitToElementAndChildren : NoLimit) of (GuiGraphicsComposition::MinSizeLimitation)">
              <Table AlignmentToParent="left:0 top:0 right:2 bottom:0" MinSizeLimitation="LimitToElementAndChildren">
                <att.Rows>
                  <CellOption>composeType:Percentage percentage:1.0</CellOption>
                  <CellOption>composeType:Absolute absolute:16</CellOption>
                  <CellOption>composeType:Percentage percentage:1.0</CellOption>
                </att.Rows>
                <att.Columns>
                  <CellOption>composeType:Absolute absolute:16</CellOption>
                </att.Columns>

                <Cell Site="row:1 column:0" AssociatedHitTestResult="Icon">
                  <ImageFrame Stretch="true" Image-bind="self.Icon is not null ? self.Icon.Image : null" FrameIndex-bind="self.Icon is not null ? self.Icon.FrameIndex : -1"/>
                </Cell>
              </Table>
            </Cell>
            <Cell ref.Name="titleCell" Site="row:0 column:1" AssociatedHitTestResult="Title">
              <Bounds>
                <!-- Mirror the caption controls when space permits. Keep the title readable in narrow dialogs. -->
                <att.AlignmentToParent-bind><![CDATA[
                  let offset = container.CachedBounds.x2 - titleCell.CachedBounds.x2 - titleCell.CachedBounds.x1,
                      available = (titleCell.CachedBounds.x2 - titleCell.CachedBounds.x1) / 4 in (
                    {left:8 + (offset < 0 ? 0 : offset < available ? offset : available); top:7; right:8; bottom:7;} of Margin
                  )
                ]]></att.AlignmentToParent-bind>
                <SolidLabel ref.Style="windowTitle" Text-bind="self.Text" Ellipse="true" Font-bind="{fontFamily:self.Font.fontFamily size:self.Font.size bold:true antialias:self.Font.antialias}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Bounds>
            </Cell>
            <!-- The exposed strip beside the client completes the nine-pixel right resize area. -->
            <Cell ref.Name="clientCell" Site="row:1 column:0 columnSpan:5" AssociatedHitTestResult="BorderRight">
              <Bounds ref.Name="container" AssociatedHitTestResult="Client" AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
            </Cell>
          </Table>
        </Bounds>
      </WindowTemplate>
    </Instance>
  </Instance>
  <Instance name="CaptionButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::CaptionButtonTemplate" ref.Styles="res://UbuntuSkin/Style">
      <ref.Members><![CDATA[
        prop CloseAction : bool = false {}
        prop WindowActive : bool = true {}
      ]]></ref.Members>
      <ButtonTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.WindowActive-bind>(cast bool self.Context) ?? true</att.WindowActive-bind>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <Table AlignmentToParent="left:0 top:0 right:0 bottom:0">
            <att.Rows><CellOption>composeType:Percentage percentage:1.0</CellOption><CellOption>composeType:Absolute absolute:20</CellOption><CellOption>composeType:Percentage percentage:1.0</CellOption></att.Rows>
            <att.Columns><CellOption>composeType:Percentage percentage:1.0</CellOption><CellOption>composeType:Absolute absolute:20</CellOption><CellOption>composeType:Percentage percentage:1.0</CellOption></att.Columns>
            <Cell Site="row:1 column:1">
              <SolidBackground Shape="shapeType:Ellipse" Color-bind="not self.VisuallyEnabled or not self.WindowActive ? ubuntuColors.InactiveCaptionButtonSurface : self.State == ButtonState::Pressed ? ubuntuColors.CaptionButtonPressed : self.State == ButtonState::Active ? ubuntuColors.CaptionButtonHovered : ubuntuColors.CaptionButtonSurface"/>
            </Cell>
          </Table>
        </Bounds>
        <Bounds ref.Name="container" AlignmentToParent="left:2 top:2 right:2 bottom:2">
          <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0" PreferredMinSize="x:16 y:24" Visible-bind="self.CloseAction">
            <Polygon Size="x:8 y:8" BorderColor-bind="self.VisuallyEnabled and self.WindowActive ? ubuntuColors.HeaderInk : ubuntuColors.InactiveHeaderInk" BackgroundColor-bind="self.VisuallyEnabled and self.WindowActive ? ubuntuColors.HeaderInk : ubuntuColors.InactiveHeaderInk">
              <att.Points>
                <Point>x:0 y:1</Point><Point>x:1 y:0</Point><Point>x:3 y:2</Point><Point>x:4 y:2</Point>
                <Point>x:6 y:0</Point><Point>x:7 y:1</Point><Point>x:5 y:3</Point><Point>x:5 y:4</Point>
                <Point>x:7 y:6</Point><Point>x:6 y:7</Point><Point>x:4 y:5</Point><Point>x:3 y:5</Point>
                <Point>x:1 y:7</Point><Point>x:0 y:6</Point><Point>x:2 y:4</Point><Point>x:2 y:3</Point>
              </att.Points>
            </Polygon>
          </Bounds>
        </Bounds>
      </ButtonTemplate>
    </Instance>
  </Instance>
  <Instance name="CaptionCloseButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::CaptionCloseButtonTemplate" xmlns:x="ubuntuskin::*">
      <x:CaptionButtonTemplate CloseAction="true"/>
    </Instance>
  </Instance>
</Folder>
