<Styles>
  <Style ref.Path="(//Bounds + //Table + //RepeatStack + //RepeatFlow)" MinSizeLimitation="LimitToElementAndChildren"/>
  <Style ref.Path="//*.generalBackground" Color-eval="ubuntuskin::ubuntuColors.WindowBackground"/>
  <Style ref.Path="//*.windowBorder" Color-bind="self.VisuallyEnabled and self.Activated ? ubuntuskin::ubuntuColors.FrameBorder : ubuntuskin::ubuntuColors.Divider"/>
  <Style ref.Path="//*.windowTitle">
    <att.Color-bind>
      <![CDATA[
        cast Color (
          self.VisuallyEnabled and self.Activated ? ubuntuskin::ubuntuColors.HeaderInk :
          ubuntuskin::ubuntuColors.InactiveHeaderInk
        )
      ]]>
    </att.Color-bind>
  </Style>
  <Style ref.Path="//*.labelDefaultText" DefaultTextColor-eval="ubuntuskin::ubuntuColors.Ink"/>
  <Style ref.Path="//*.labelText">
    <att.Color-bind>
      <![CDATA[
        cast Color (
          not self.VisuallyEnabled ? ubuntuskin::ubuntuColors.DisabledInk :
          self.InTooltip and self.TextColor == self.DefaultTextColor ? ubuntuskin::ubuntuColors.KeytipText :
          self.TextColor
        )
      ]]>
    </att.Color-bind>
  </Style>
  <Style ref.Path="//*.datePickerColors">
    <att.BackgroundColor-eval>ubuntuskin::ubuntuColors.WindowBackground</att.BackgroundColor-eval>
    <att.PrimaryTextColor-eval>ubuntuskin::ubuntuColors.DocumentInk</att.PrimaryTextColor-eval>
    <att.SecondaryTextColor-eval>ubuntuskin::ubuntuColors.SecondaryInk</att.SecondaryTextColor-eval>
  </Style>
  <Style ref.Path="//*.listBorder">
    <att.Color-bind>
      <![CDATA[
        cast Color (
          not self.VisuallyEnabled ? ubuntuskin::ubuntuColors.Border :
          self.Focused ? ubuntuskin::ubuntuColors.Focus :
          ubuntuskin::ubuntuColors.Border
        )
      ]]>
    </att.Color-bind>
  </Style>
  <Style ref.Path="//*.textListBackgroundAndColor">
    <att.TextColor-eval>ubuntuskin::ubuntuColors.ItemNormal.Text</att.TextColor-eval>
    <SolidBackground Color-eval="ubuntuskin::ubuntuColors.ViewBackground"/>
  </Style>
  <Style ref.Path="//*.listViewBackgroundAndColor">
    <att.PrimaryTextColor-eval>ubuntuskin::ubuntuColors.ItemNormal.Text</att.PrimaryTextColor-eval>
    <att.SecondaryTextColor-eval>ubuntuskin::ubuntuColors.SecondaryInk</att.SecondaryTextColor-eval>
    <att.ItemSeparatorColor-eval>ubuntuskin::ubuntuColors.Divider</att.ItemSeparatorColor-eval>
    <SolidBackground Color-eval="ubuntuskin::ubuntuColors.ViewBackground"/>
  </Style>
  <Style ref.Path="//*.treeViewBackgroundAndColor">
    <att.TextColor-eval>ubuntuskin::ubuntuColors.ItemNormal.Text</att.TextColor-eval>
    <SolidBackground Color-eval="ubuntuskin::ubuntuColors.ViewBackground"/>
  </Style>
  <Style ref.Path="//*.controlText">
    <att.Color-bind>
      <![CDATA[
        cast Color (
          not self.VisuallyEnabled ? ubuntuskin::ubuntuColors.DisabledInk :
          ubuntuskin::ubuntuColors.Ink
        )
      ]]>
    </att.Color-bind>
  </Style>
  <Style ref.Path="//*.toolstripMenuBackground" Color-eval="ubuntuskin::ubuntuColors.PopupBackground"/>
  <Style ref.Path="//*.toolstripMenuBorder" Color-eval="ubuntuskin::ubuntuColors.Border"/>
  <Style ref.Path="//*.toolstripSplitter" Color-eval="ubuntuskin::ubuntuColors.Divider"/>
  <Style ref.Path="//*.toolstripArrow" BorderColor-bind="self.animation.Current.Text" BackgroundColor-bind="self.animation.Current.Text"/>
  <Style ref.Path="//*.toolstripSplitArrow" BorderColor-bind="self.VisuallyEnabled ? ubuntuskin::ubuntuColors.Ink : ubuntuskin::ubuntuColors.DisabledInk" BackgroundColor-bind="self.VisuallyEnabled ? ubuntuskin::ubuntuColors.Ink : ubuntuskin::ubuntuColors.DisabledInk"/>
  <Style ref.Path="//*.ribbonGroupBorder" Color-eval="ubuntuskin::ubuntuColors.Divider"/>
  <Style ref.Path="//*.ribbonGroupTitle" Color-eval="ubuntuskin::ubuntuColors.SecondaryInk"/>
  <Style ref.Path="//*.ribbonMenuBorder" Color-eval="ubuntuskin::ubuntuColors.Border"/>
  <Style ref.Path="//*.ribbonExpandableArrow" BorderColor-bind="self.VisuallyEnabled and self.State == ButtonState::Pressed ? ubuntuskin::ubuntuColors.Ink : ubuntuskin::ubuntuColors.SecondaryInk" BackgroundColor-bind="self.VisuallyEnabled and self.State == ButtonState::Pressed ? ubuntuskin::ubuntuColors.Ink : ubuntuskin::ubuntuColors.SecondaryInk"/>
  <Style ref.Path="//*.documentBoxBackgroundAndColor" BaselineDocument-eval="ubuntuskin::CreateBaselineDocument()">
    <att.CaretColor-eval>ubuntuskin::ubuntuColors.DocumentInk</att.CaretColor-eval>
    <SolidBackground Color-eval="ubuntuskin::ubuntuColors.ViewBackground"/>
  </Style>
</Styles>
