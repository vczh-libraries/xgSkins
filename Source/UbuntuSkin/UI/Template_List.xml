  <Instance name="ListViewColumnDropDownTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::ListViewColumnDropDownTemplate" ref.Styles="res://UbuntuSkin/Style">
      <SelectableButtonTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren" PreferredMinSize="x:13 y:0">
        <Bounds AlignmentToParent="left:0 top:1 right:-1 bottom:1" PreferredMinSize="x:1 y:0" Visible-bind="not self.VisuallyEnabled or (self.State == ButtonState::Normal and not self.Selected)">
          <SolidBackground Color-eval="ubuntuColors.Divider"/>
        </Bounds>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0" Visible-bind="self.VisuallyEnabled and (self.State != ButtonState::Normal or self.Selected)">
          <SolidBorder Color-eval="ubuntuColors.Border"/>
          <Bounds AlignmentToParent="left:2 top:2 right:2 bottom:2">
            <SolidBackground Color-bind="self.Selected or self.State == ButtonState::Pressed ? ubuntuColors.PressedSurface : ubuntuColors.HoverSurface"/>
          </Bounds>
        </Bounds>
        <Table AlignmentToParent="left:3 top:3 right:3 bottom:3">
          <att.Rows>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
            <CellOption>composeType:MinSize</CellOption>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
          </att.Rows>
          <att.Columns><CellOption>composeType:MinSize</CellOption></att.Columns>
          <Cell Site="row:1 column:0">
            <Polygon Size="x:7 y:4" BorderColor-eval="ubuntuColors.Ink" BackgroundColor-eval="ubuntuColors.Ink">
              <att.Points><Point>x:0 y:0</Point><Point>x:3 y:3</Point><Point>x:6 y:0</Point></att.Points>
            </Polygon>
          </Cell>
        </Table>
      </SelectableButtonTemplate>
    </Instance>
  </Instance>
