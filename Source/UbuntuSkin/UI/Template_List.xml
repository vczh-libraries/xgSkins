<Folder>
  <Instance name="ItemBackgroundTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::ItemBackgroundTemplate" ref.Styles="res://UbuntuSkin/Style">
      <ref.Members><![CDATA[
        prop PointerPressed : bool = false {}
        prop HoverColors : ButtonColors = ubuntuColors.ItemHovered {}
        prop Colors : ButtonColors = ubuntuColors.ItemNormal {}
      ]]></ref.Members>
      <SelectableButtonTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.Colors-bind>not self.VisuallyEnabled ? ubuntuColors.ItemDisabled : self.PointerPressed or self.State == ButtonState::Pressed ? ubuntuColors.ItemPressed : self.Selected ? ubuntuColors.ItemSelected : self.State == ButtonState::Active ? self.HoverColors : ubuntuColors.ItemNormal</att.Colors-bind>
        <ev.mouseDown-eval>if (arguments.button == NativeMouseButton::Left) { self.PointerPressed = true; }</ev.mouseDown-eval>
        <ev.mouseUp-eval>if (arguments.button == NativeMouseButton::Left) { self.PointerPressed = false; }</ev.mouseUp-eval>
        <ev.mouseLeave-eval>self.PointerPressed = false;</ev.mouseLeave-eval>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0" Visible-bind="not self.Colors.HideBackground">
          <GradientBackground Direction="Vertical" Color1-bind="self.Colors.G1" Color2-bind="self.Colors.G2"/>
        </Bounds>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0" Visible-bind="not self.Colors.HideBackground">
          <SolidBorder Color-bind="self.Colors.Border"/>
        </Bounds>
        <Bounds ref.Name="container" AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
      </SelectableButtonTemplate>
    </Instance>
  </Instance>

  <Instance name="TextListTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::TextListTemplate" ref.Styles="res://UbuntuSkin/Style" xmlns:x="ubuntuskin::*">
      <TextListTemplate ref.Name="self" ref.Style="textListBackgroundAndColor" MinSizeLimitation="LimitToElementAndChildren">
        <att.ContainerComposition-eval>look.ContainerComposition</att.ContainerComposition-eval>
        <att.HorizontalScroll-eval>look.HScroll</att.HorizontalScroll-eval>
        <att.VerticalScroll-eval>look.VScroll</att.VerticalScroll-eval>
        <att.BackgroundTemplate>ubuntuskin::ItemBackgroundTemplate</att.BackgroundTemplate>
        <att.CheckBulletTemplate>ubuntuskin::CheckBoxTemplate</att.CheckBulletTemplate>
        <att.RadioBulletTemplate>ubuntuskin::RadioButtonTemplate</att.RadioBulletTemplate>

        <x:EditorBorderTemplate AlignmentToParent="left:0 top:0 right:0 bottom:0" Focused-bind="self.Focused" VisuallyEnabled-bind="self.VisuallyEnabled">
          <CommonScrollViewLook ref.Name="look" AlignmentToParent="left:2 top:2 right:2 bottom:2">
            <att.HScrollTemplate>ubuntuskin::HScrollTemplate</att.HScrollTemplate>
            <att.VScrollTemplate>ubuntuskin::VScrollTemplate</att.VScrollTemplate>
            <att.DefaultScrollSize>12</att.DefaultScrollSize>
          </CommonScrollViewLook>
        </x:EditorBorderTemplate>
      </TextListTemplate>
    </Instance>
  </Instance>

  <Instance name="ComboBoxMenuTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::ComboBoxMenuTemplate" xmlns:x="ubuntuskin::*">
      <x:ToolstripMenuTemplate ContentInset="left:1 top:1 right:1 bottom:1"/>
    </Instance>
  </Instance>

  <Instance name="ComboBoxTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::ComboBoxTemplate" ref.Styles="res://UbuntuSkin/Style">
      <ref.Members><![CDATA[
        prop Colors : ButtonColors = ubuntuColors.ComboNormal {}
        var animationBuilder : ButtonColorAnimation^ = new ButtonColorAnimation^(new ButtonColorState^(ubuntuColors.ComboNormal));
        var lastAnimation : IGuiAnimation^ = null;
        func UpdateColors() : void
        {
          KillAnimation(lastAnimation);
          lastAnimation = CompleteColorAnimation(animationBuilder.CreateAnimation(new ButtonColorState^(self.Colors), cast UInt64 150), func():void { animationBuilder.Interpolate(1.0); });
          AddAnimation(lastAnimation);
        }
      ]]></ref.Members>
      <DateComboBoxTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.SubMenuTemplate>ubuntuskin::ComboBoxMenuTemplate</att.SubMenuTemplate>
        <att.DatePickerTemplate>ubuntuskin::DatePickerTemplate</att.DatePickerTemplate>
        <att.Colors-bind>not self.VisuallyEnabled ? ubuntuColors.ButtonDisabled : self.SubMenuOpening ? ubuntuColors.CommandOpen : self.State == ButtonState::Pressed ? ubuntuColors.CommandPressed : self.State == ButtonState::Active ? ubuntuColors.CommandHovered : ubuntuColors.ComboNormal</att.Colors-bind>
        <ev.ColorsChanged-eval>self.UpdateColors();</ev.ColorsChanged-eval>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <SolidBorder Color-bind="self.animationBuilder.Current.Border"/>
        </Bounds>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
          <GradientBackground Direction="Vertical" Color1-bind="self.animationBuilder.Current.G1" Color2-bind="self.animationBuilder.Current.G2"/>
        </Bounds>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1" Visible-bind="self.VisuallyEnabled and self.Focused"><SolidBorder Color-eval="ubuntuskin::ubuntuColors.Focus"/></Bounds>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <Bounds ref.Name="container" AlignmentToParent="left:3 top:3 right:18 bottom:3">
            <Bounds AlignmentToParent="left:2 top:2 right:2 bottom:2" Visible-bind="self.TextVisible">
              <SolidLabel Color-bind="self.animationBuilder.Current.Text" Text-bind="self.Text" Font-bind="self.Font" Ellipse="true" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Bounds>
          </Bounds>

          <Table AlignmentToParent="left:-1 top:1 right:3 bottom:1" PreferredMinSize="x:13 y:0">
            <att.Rows>
              <CellOption>composeType:Percentage percentage:0.5</CellOption>
              <CellOption>composeType:Absolute absolute:3</CellOption>
              <CellOption>composeType:Percentage percentage:0.5</CellOption>
            </att.Rows>
            <att.Columns>
              <CellOption>composeType:Percentage percentage:0.5</CellOption>
              <CellOption>composeType:Absolute absolute:5</CellOption>
              <CellOption>composeType:Percentage percentage:0.5</CellOption>
            </att.Columns>

            <Cell Site="row:1 column:1">
              <Polygon BorderColor-bind="self.animationBuilder.Current.Text" BackgroundColor-bind="self.animationBuilder.Current.Text" Size="x:5 y:3">
                <att.Points>
                  <Point>x:0 y:0</Point>
                  <Point>x:2 y:2</Point>
                  <Point>x:4 y:0</Point>
                </att.Points>
              </Polygon>
            </Cell>
          </Table>
        </Bounds>
      </DateComboBoxTemplate>
    </Instance>
  </Instance>

  <Instance name="ListViewColumnHeaderTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::ListViewColumnHeaderTemplate" ref.Styles="res://UbuntuSkin/Style">
      <ListViewColumnHeaderTemplate ref.Name="self" ContainerComposition-ref="container" SubMenuHost-ref="buttonArrow" MinSizeLimitation="LimitToElementAndChildren">
        <SolidBackground Color-bind="not self.VisuallyEnabled ? ubuntuColors.ViewBackground : self.SubMenuOpening or self.State == ButtonState::Pressed ? ubuntuColors.PressedSurface : self.State == ButtonState::Active ? ubuntuColors.HoverSurface : ubuntuColors.ViewBackground"/>
        <Bounds AlignmentToParent="left:0 top:-1 right:0 bottom:0" PreferredMinSize="x:0 y:1">
          <SolidBackground Color-eval="ubuntuColors.Divider"/>
        </Bounds>
        <Bounds ref.Name="container" AlignmentToParent="left:1 top:1 right:11 bottom:1">
          <Bounds AlignmentToParent-bind="{left:6 top:4 right:(self.SortingState == ColumnSortingState::NotSorted ? 5 : 13) bottom:4}">
            <SolidLabel Color-bind="not self.VisuallyEnabled ? ubuntuColors.DisabledInk : self.State == ButtonState::Pressed ? ubuntuColors.Ink : ubuntuColors.SecondaryInk" Text-bind="self.Text" Font-bind="self.Font" Ellipse="true" HorizontalAlignment="Left" VerticalAlignment="Center"/>
          </Bounds>
          <Bounds AlignmentToParent="left:-1 top:0 right:1 bottom:0" Visible-bind="self.SortingState == ColumnSortingState::Ascending">
            <Polygon Size="x:9 y:5" BorderColor-eval="ubuntuColors.SecondaryInk" BackgroundColor-eval="ubuntuColors.SecondaryInk">
              <att.Points><Point>x:0 y:4</Point><Point>x:4 y:0</Point><Point>x:8 y:4</Point><Point>x:4 y:1</Point></att.Points>
            </Polygon>
          </Bounds>
          <Bounds AlignmentToParent="left:-1 top:0 right:1 bottom:0" Visible-bind="self.SortingState == ColumnSortingState::Descending">
            <Polygon Size="x:9 y:5" BorderColor-eval="ubuntuColors.SecondaryInk" BackgroundColor-eval="ubuntuColors.SecondaryInk">
              <att.Points><Point>x:0 y:0</Point><Point>x:4 y:4</Point><Point>x:8 y:0</Point><Point>x:4 y:3</Point></att.Points>
            </Polygon>
          </Bounds>
        </Bounds>
        <Bounds AlignmentToParent="left:-1 top:0 right:0 bottom:0">
          <CheckBox ref.Name="buttonArrow" AutoFocus="false" AutoSelection="false" ControlTemplate="ubuntuskin::ListViewColumnDropDownTemplate" Selected-bind="self.SubMenuOpening" Visible-bind="self.SubMenuExisting and (self.SubMenuOpening or self.State != ButtonState::Normal)">
            <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
          </CheckBox>
        </Bounds>
      </ListViewColumnHeaderTemplate>
    </Instance>
  </Instance>

  <Instance name="ListViewTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::ListViewTemplate" ref.Styles="res://UbuntuSkin/Style" xmlns:x="ubuntuskin::*">
      <ListViewTemplate ref.Name="self" ref.Style="listViewBackgroundAndColor" MinSizeLimitation="LimitToElementAndChildren">
