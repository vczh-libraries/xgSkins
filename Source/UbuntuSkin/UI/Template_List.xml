  <Instance name="ExpandingDecoratorTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::ExpandingDecoratorTemplate" ref.Styles="res://UbuntuSkin/Style">
      <SelectableButtonTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren">
        <Table AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <att.Rows>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
            <CellOption>composeType:Absolute absolute:11</CellOption>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
          </att.Rows>
          <att.Columns>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
            <CellOption>composeType:Absolute absolute:6</CellOption>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
          </att.Columns>

          <Cell Site="row:1 column:1">
            <Bounds Visible-bind="not self.Selected">
              <Polygon Size="x:6 y:11" BorderColor-bind="not self.VisuallyEnabled ? ubuntuColors.DisabledInk : self.State == ButtonState::Normal ? ubuntuColors.SecondaryInk : ubuntuColors.Ink" BackgroundColor-bind="not self.VisuallyEnabled ? ubuntuColors.DisabledInk : self.State == ButtonState::Normal ? ubuntuColors.SecondaryInk : ubuntuColors.Ink">
                <att.Points>
                  <Point>x:0 y:1</Point>
                  <Point>x:4 y:5</Point>
                  <Point>x:0 y:9</Point>
                </att.Points>
              </Polygon>
            </Bounds>
            <Bounds Visible-bind="self.Selected">
              <Polygon Size="x:6 y:11" BorderColor-bind="not self.VisuallyEnabled ? ubuntuColors.DisabledInk : self.State == ButtonState::Normal ? ubuntuColors.SecondaryInk : ubuntuColors.Ink" BackgroundColor-bind="not self.VisuallyEnabled ? ubuntuColors.DisabledInk : self.State == ButtonState::Normal ? ubuntuColors.SecondaryInk : ubuntuColors.Ink">
                <att.Points>
                  <Point>x:5 y:2</Point>
                  <Point>x:5 y:7</Point>
                  <Point>x:0 y:7</Point>
                </att.Points>
              </Polygon>
            </Bounds>
          </Cell>
        </Table>
      </SelectableButtonTemplate>
    </Instance>
  </Instance>

  <Instance name="TreeViewTemplateResource">
