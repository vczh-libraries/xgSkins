  <Instance name="ProgressBarTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::ProgressBarTemplate" ref.Styles="res://UbuntuSkin/Style">
      <ScrollTemplate ref.Name="self" ContainerComposition-ref="container" PreferredMinSize="y:6" MinSizeLimitation="LimitToElementAndChildren">
        <Table AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <att.Rows>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
            <CellOption>composeType:Absolute absolute:6</CellOption>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
          </att.Rows>
          <att.Columns><CellOption>composeType:Percentage percentage:1.0</CellOption></att.Columns>
          <Cell Site="row:1 column:0">
            <SolidBackground Shape="shapeType:RoundRect radiusX:3 radiusY:3" Color-eval="ubuntuColors.Track"/>
            <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
              <SolidBorder Shape="shapeType:RoundRect radiusX:3 radiusY:3" Color-eval="ubuntuColors.Border"/>
            </Bounds>
            <PartialView>
              <att.WidthPageSize-bind><![CDATA[
                self.Position <= 0 ? 0.0 : self.Position >= self.TotalSize - self.PageSize ? 1.0 :
                (cast double self.Position) / (self.TotalSize - self.PageSize)
              ]]></att.WidthPageSize-bind>
              <SolidBackground Shape="shapeType:RoundRect radiusX:3 radiusY:3" Color-eval="ubuntuColors.ControlAccent"/>
            </PartialView>
          </Cell>
        </Table>
        <Bounds ref.Name="container" AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
      </ScrollTemplate>
    </Instance>
  </Instance>

