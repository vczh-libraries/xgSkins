<Instance name="TopScrollButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::TopScrollButtonTemplate" ref.Styles="res://UbuntuSkin/Style">
      <ref.Members><![CDATA[
        var animationBuilder : ButtonColorAnimation^ = new ButtonColorAnimation^(new ButtonColorState^(GetScrollButtonColors(true, ButtonState::Normal, true)));
        var lastAnimation : IGuiAnimation^ = null;

        func UpdateColors() : void
        {
          KillAnimation(lastAnimation);
          lastAnimation = CompleteColorAnimation(animationBuilder.CreateAnimation(new ButtonColorState^(GetScrollButtonColors(self.VisuallyEnabled, self.State, true)), cast UInt64 150), func():void { animationBuilder.Interpolate(1.0); });
          AddAnimation(lastAnimation);
        }
      ]]></ref.Members>
      <ButtonTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren">
        <ev.StateChanged-eval>self.UpdateColors();</ev.StateChanged-eval>
        <ev.VisuallyEnabledChanged-eval>self.UpdateColors();</ev.VisuallyEnabledChanged-eval>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <SolidBorder Color-bind="self.animationBuilder.Current.Border"/>
        </Bounds>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
          <GradientBackground Direction="Vertical" Color1-bind="self.animationBuilder.Current.G1" Color2-bind="self.animationBuilder.Current.G2"/>
        </Bounds>
        <Table AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <att.Rows>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
            <CellOption>composeType:Absolute absolute:5</CellOption>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
          </att.Rows>
          <att.Columns>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
            <CellOption>composeType:Absolute absolute:9</CellOption>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
          </att.Columns>

          <Cell Site="row:1 column:1">
            <Polygon BorderColor-bind="self.animationBuilder.Current.Text" BackgroundColor-bind="self.animationBuilder.Current.Text" Size="x:9 y:5">
              <att.Points>
                <Point>x:0 y:4</Point>
                <Point>x:4 y:0</Point>
                <Point>x:8 y:4</Point>
              </att.Points>
            </Polygon>
          </Cell>
        </Table>
      </ButtonTemplate>
    </Instance>
  </Instance>

