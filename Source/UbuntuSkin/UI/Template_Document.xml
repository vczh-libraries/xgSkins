<Folder>
  <Script name="EditorColors">
    <Workflow><![CDATA[
      module UbuntuEditorColors;
      using presentation::*;
      namespace ubuntuskin
      {
        struct EditorColors
        {
          Border : Color;
          Background : Color;
        }

        class EditorColorState
        {
          prop Border : Color = {} {}
          prop Background : Color = {} {}
          new() {}

          new(colors : EditorColors)
          {
            Border = colors.Border;
            Background = colors.Background;
          }
        }
      }
    ]]></Workflow>
  </Script>

  <Animation name="EditorColorAnimation">
    <Gradient ref.Class="ubuntuskin::EditorColorAnimation" Type="ubuntuskin::EditorColorState">
      <Interpolation><![CDATA[[$1]]]></Interpolation>
      <Targets><Target Name="Border"/><Target Name="Background"/></Targets>
    </Gradient>
  </Animation>

  <Instance name="EditorBorderTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::EditorBorderTemplate" ref.Styles="res://UbuntuSkin/Style">
      <ref.Members><![CDATA[
        prop Hovered : bool = false {}
        prop Sidebar : bool = false {}
        prop Colors : EditorColors = ubuntuColors.EditorNormal {}
        var animationBuilder : EditorColorAnimation^ = new EditorColorAnimation^(new EditorColorState^(ubuntuColors.EditorNormal));
        var lastAnimation : IGuiAnimation^ = null;
        func UpdateColors() : void
        {
          KillAnimation(lastAnimation);
          lastAnimation = CompleteColorAnimation(animationBuilder.CreateAnimation(new EditorColorState^(self.Colors), cast UInt64 150), func():void { animationBuilder.Interpolate(1.0); });
          AddAnimation(lastAnimation);
        }
      ]]></ref.Members>
      <ControlTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren">
        <att.Colors-bind>not self.VisuallyEnabled ? ubuntuColors.EditorDisabled : self.Focused ? ubuntuColors.EditorFocused : self.Hovered ? ubuntuColors.EditorHovered : ubuntuColors.EditorNormal</att.Colors-bind>
        <ev.ColorsChanged-eval>self.UpdateColors();</ev.ColorsChanged-eval>
        <ev.mouseEnter-eval>self.Hovered = true;</ev.mouseEnter-eval>
        <ev.mouseLeave-eval>self.Hovered = false;</ev.mouseLeave-eval>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
          <SolidBackground Shape="shapeType:RoundRect radiusX:4 radiusY:4" Color-bind="self.Sidebar and self.VisuallyEnabled ? ubuntuColors.WindowBackground : self.animationBuilder.Current.Background"/>
        </Bounds>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <SolidBorder Shape="shapeType:RoundRect radiusX:5 radiusY:5" Color-bind="self.animationBuilder.Current.Border"/>
        </Bounds>
      </ControlTemplate>
    </Instance>
  </Instance>

  <Instance name="DocumentLabelTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::DocumentLabelTemplate" ref.Styles="res://UbuntuSkin/Style">
      <DocumentLabelTemplate ref.Name="self" ref.Style="documentBoxBackgroundAndColor" MinSizeLimitation="LimitToElementAndChildren"/>
    </Instance>
  </Instance>

  <Instance name="DocumentTextBoxTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::DocumentTextBoxTemplate" ref.Styles="res://UbuntuSkin/Style" xmlns:x="ubuntuskin::*">
      <DocumentLabelTemplate ref.Name="self" BaselineDocument-eval="ubuntuskin::CreateBaselineDocument()" CaretColor-eval="ubuntuskin::ubuntuColors.Ink" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <x:EditorBorderTemplate AlignmentToParent="left:0 top:0 right:0 bottom:0" Focused-bind="self.Focused" VisuallyEnabled-bind="self.VisuallyEnabled">
          <Bounds ref.Name="container" AlignmentToParent="left:2 top:2 right:2 bottom:2"/>
        </x:EditorBorderTemplate>
      </DocumentLabelTemplate>
    </Instance>
  </Instance>

  <Instance name="DocumentViewerTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="ubuntuskin::DocumentViewerTemplate" ref.Styles="res://UbuntuSkin/Style" xmlns:x="ubuntuskin::*">
      <DocumentViewerTemplate ref.Name="self" BaselineDocument-eval="ubuntuskin::CreateBaselineDocument()" CaretColor-eval="ubuntuskin::ubuntuColors.Ink" MinSizeLimitation="LimitToElementAndChildren">
        <att.ContainerComposition-eval>look.ContainerComposition</att.ContainerComposition-eval>
        <att.HorizontalScroll-eval>look.HScroll</att.HorizontalScroll-eval>
        <att.VerticalScroll-eval>look.VScroll</att.VerticalScroll-eval>
        <x:EditorBorderTemplate AlignmentToParent="left:0 top:0 right:0 bottom:0" Focused-bind="self.Focused" VisuallyEnabled-bind="self.VisuallyEnabled">
          <CommonScrollViewLook ref.Name="look" AlignmentToParent="left:2 top:2 right:2 bottom:2">
            <att.HScrollTemplate>ubuntuskin::HScrollTemplate</att.HScrollTemplate>
            <att.VScrollTemplate>ubuntuskin::VScrollTemplate</att.VScrollTemplate>
            <att.DefaultScrollSize>12</att.DefaultScrollSize>
          </CommonScrollViewLook>
        </x:EditorBorderTemplate>
      </DocumentViewerTemplate>
    </Instance>
  </Instance>
</Folder>
