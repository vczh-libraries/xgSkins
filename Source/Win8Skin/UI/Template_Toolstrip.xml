          <Cell Site="row:2 column:8" Visible-bind="self.SubMenuExisting">
            <Polygon BorderColor-bind="self.Colors.Text" BackgroundColor-bind="self.Colors.Text" Size="x:4 y:7">
              <att.Points>
                <Point>x:0 y:0</Point>
                <Point>x:3 y:3</Point>
                <Point>x:0 y:6</Point>
              </att.Points>
            </Polygon>
          </Cell>
