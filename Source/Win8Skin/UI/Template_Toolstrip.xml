  <Instance name="ToolstripButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win8skin::ToolstripButtonTemplate" ref.Styles="res://Win8Skin/Style">
      <ref.Members><![CDATA[
        prop Colors : ButtonColors = win8Colors.ToolstripButtonNormal {}
        var animation : ButtonColorAnimation^ = new ButtonColorAnimation^(new ButtonColorState^(win8Colors.ToolstripButtonNormal));
        var lastAnimation : IGuiAnimation^ = null;
      ]]></ref.Members>
      <ToolstripButtonTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.Colors-bind>not self.VisuallyEnabled ? win8Colors.ToolstripButtonDisabled : self.State == ButtonState::Pressed or self.SubMenuOpening ? win8Colors.ToolstripButtonPressed : self.Selected ? win8Colors.ToolstripButtonSelected : self.State == ButtonState::Active ? win8Colors.ToolstripButtonActive : win8Colors.ToolstripButtonNormal</att.Colors-bind>
        <ev.ColorsChanged-eval><![CDATA[{
          self.KillAnimation(self.lastAnimation);
          self.lastAnimation = CompleteColorAnimation(self.animation.CreateAnimation(new ButtonColorState^(self.Colors), cast UInt64 120), func():void { self.animation.Interpolate(1.0); });
          self.AddAnimation(self.lastAnimation);
        }]]></ev.ColorsChanged-eval>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0"><SolidBorder Color-bind="self.animation.Current.Border"/></Bounds>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
          <GradientBackground Direction="Vertical" Color1-bind="self.animation.Current.G1" Color2-bind="self.animation.Current.G2"/>
        </Bounds>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">

          <Bounds ref.Name ="container" AlignmentToParent="left:3 top:3 right:3 bottom:3">
            <ImageFrame Image-bind="self.Image.Image ?? null" FrameIndex-bind="self.Image.FrameIndex ?? 0" Enabled-bind="self.VisuallyEnabled"/>
          </Bounds>
        </Bounds>
      </ToolstripButtonTemplate>
    </Instance>
  </Instance>

