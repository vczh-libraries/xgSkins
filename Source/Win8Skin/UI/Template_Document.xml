<Folder>
  <Script name="EditorColors">
    <Workflow><![CDATA[
      module Win8EditorColors;
      using presentation::*;
      namespace win8skin
      {
        struct EditorColors
        {
          Border : Color;
          Background : Color;
        }

        class EditorColorState
        {
          prop Border : Color = {} {}
          prop Background : Color = {} {}
          new() {}

          new(colors : EditorColors)
          {
            Border = colors.Border;
            Background = colors.Background;
          }
        }
      }
    ]]></Workflow>
  </Script>

  <Animation name="EditorColorAnimation">
    <Gradient ref.Class="win8skin::EditorColorAnimation" Type="win8skin::EditorColorState">
      <Interpolation><![CDATA[[$1]]]></Interpolation>
      <Targets><Target Name="Border"/><Target Name="Background"/></Targets>
    </Gradient>
  </Animation>

  <Instance name="EditorBorderTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win8skin::EditorBorderTemplate" ref.Styles="res://Win8Skin/Style">
      <ref.Members><![CDATA[
        prop Hovered : bool = false {}
        prop Colors : EditorColors = win8Colors.EditorNormal {}
        var animationBuilder : EditorColorAnimation^ = new EditorColorAnimation^(new EditorColorState^(win8Colors.EditorNormal));
        var lastAnimation : IGuiAnimation^ = null;
        func UpdateColors() : void
        {
          KillAnimation(lastAnimation);
          lastAnimation = CompleteColorAnimation(animationBuilder.CreateAnimation(new EditorColorState^(self.Colors), cast UInt64 120), func():void { animationBuilder.Interpolate(1.0); });
          AddAnimation(lastAnimation);
        }
      ]]></ref.Members>
      <ControlTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren">
        <att.Colors-bind>not self.VisuallyEnabled ? win8Colors.EditorDisabled : self.Focused ? win8Colors.EditorFocused : self.Hovered ? win8Colors.EditorHovered : win8Colors.EditorNormal</att.Colors-bind>
        <ev.ColorsChanged-eval>self.UpdateColors();</ev.ColorsChanged-eval>
        <ev.mouseEnter-eval>self.Hovered = true;</ev.mouseEnter-eval>
        <ev.mouseLeave-eval>self.Hovered = false;</ev.mouseLeave-eval>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
          <SolidBackground Color-bind="self.animationBuilder.Current.Background"/>
        </Bounds>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <SolidBorder Color-bind="self.animationBuilder.Current.Border"/>
        </Bounds>
      </ControlTemplate>
    </Instance>
  </Instance>

  <Instance name="DocumentLabelTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win8skin::DocumentLabelTemplate" ref.Styles="res://Win8Skin/Style">
      <DocumentLabelTemplate ref.Name="self" ref.Style="documentBoxBackgroundAndColor" MinSizeLimitation="LimitToElementAndChildren"/>
    </Instance>
  </Instance>

  <Instance name="DocumentTextBoxTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win8skin::DocumentTextBoxTemplate" ref.Styles="res://Win8Skin/Style" xmlns:x="win8skin::*">
      <DocumentLabelTemplate ref.Name="self" BaselineDocument-eval="win8skin::CreateBaselineDocument()" CaretColor-eval="win8skin::win8Colors.TextNormal" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <x:EditorBorderTemplate AlignmentToParent="left:0 top:0 right:0 bottom:0" Focused-bind="self.Focused" VisuallyEnabled-bind="self.VisuallyEnabled">
          <Bounds ref.Name="container" AlignmentToParent="left:1 top:1 right:1 bottom:1"/>
        </x:EditorBorderTemplate>
      </DocumentLabelTemplate>
    </Instance>
  </Instance>

  <Instance name="DocumentViewerTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win8skin::DocumentViewerTemplate" ref.Styles="res://Win8Skin/Style" xmlns:x="win8skin::*">
      <DocumentViewerTemplate ref.Name="self" BaselineDocument-eval="win8skin::CreateBaselineDocument()" CaretColor-eval="win8skin::win8Colors.TextNormal" MinSizeLimitation="LimitToElementAndChildren">
        <att.ContainerComposition-eval>look.ContainerComposition</att.ContainerComposition-eval>
        <att.HorizontalScroll-eval>look.HScroll</att.HorizontalScroll-eval>
        <att.VerticalScroll-eval>look.VScroll</att.VerticalScroll-eval>
        <x:EditorBorderTemplate AlignmentToParent="left:0 top:0 right:0 bottom:0" Focused-bind="self.Focused" VisuallyEnabled-bind="self.VisuallyEnabled">
          <CommonScrollViewLook ref.Name="look" AlignmentToParent="left:1 top:1 right:1 bottom:1">
            <att.HScrollTemplate>win8skin::HScrollTemplate</att.HScrollTemplate>
            <att.VScrollTemplate>win8skin::VScrollTemplate</att.VScrollTemplate>
            <att.DefaultScrollSize>20</att.DefaultScrollSize>
          </CommonScrollViewLook>
        </x:EditorBorderTemplate>
      </DocumentViewerTemplate>
    </Instance>
  </Instance>
</Folder>
