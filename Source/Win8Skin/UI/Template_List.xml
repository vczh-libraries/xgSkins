          <att.Rows>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
            <CellOption>composeType:Absolute absolute:11</CellOption>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
          </att.Rows>
          <att.Columns>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
            <CellOption>composeType:Absolute absolute:6</CellOption>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
          </att.Columns>

          <Cell Site="row:1 column:1">
            <Bounds Visible-bind="not self.Selected">
              <Polygon Size="x:6 y:11" BorderColor-bind="self.VisuallyEnabled and self.State != ButtonState::Normal ? win8Colors.TreeArrowBorderHovered : self.Selected ? win8Colors.TreeArrowBorderExpanded : win8Colors.TreeArrowBorder" BackgroundColor-bind="self.VisuallyEnabled and self.State != ButtonState::Normal ? win8Colors.TreeArrowBackgroundHovered : self.Selected ? win8Colors.TreeArrowBackgroundExpanded : win8Colors.TreeArrowBackground">
                <att.Points>
                  <Point>x:0 y:1</Point>
                  <Point>x:4 y:5</Point>
                  <Point>x:0 y:9</Point>
                </att.Points>
              </Polygon>
            </Bounds>
            <Bounds Visible-bind="self.Selected">
              <Polygon Size="x:6 y:11" BorderColor-bind="self.VisuallyEnabled and self.State != ButtonState::Normal ? win8Colors.TreeArrowBorderHovered : self.Selected ? win8Colors.TreeArrowBorderExpanded : win8Colors.TreeArrowBorder" BackgroundColor-bind="self.VisuallyEnabled and self.State != ButtonState::Normal ? win8Colors.TreeArrowBackgroundHovered : self.Selected ? win8Colors.TreeArrowBackgroundExpanded : win8Colors.TreeArrowBackground">
                <att.Points>
                  <Point>x:5 y:2</Point>
                  <Point>x:5 y:7</Point>
                  <Point>x:0 y:7</Point>
                </att.Points>
              </Polygon>
            </Bounds>
          </Cell>
        </Table>
      </SelectableButtonTemplate>
    </Instance>
