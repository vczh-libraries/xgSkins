<Folder>
  <Script name="GroupCaptionState">
    <Workflow><![CDATA[
      module VistaGroupCaption;
      using presentation::*;
      namespace winvistaskin
      {
        class GroupCaptionState
        {
          prop Text : Color = {} {}
          new() {}
          new(color : Color) { Text = color; }
        }
      }
    ]]></Workflow>
  </Script>
  <Animation name="GroupCaptionAnimation">
    <Gradient ref.Class="winvistaskin::GroupCaptionAnimation" Type="winvistaskin::GroupCaptionState">
      <Interpolation><![CDATA[[$1]]]></Interpolation>
      <Targets><Target Name="Text"/></Targets>
    </Gradient>
  </Animation>
  <Instance name="GroupBoxTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="winvistaskin::GroupBoxTemplate" ref.Styles="res://WinVistaSkin/Style">
      <ref.Members><![CDATA[
        prop CaptionColor : Color = vistaColors.GroupText {}
        var animation : GroupCaptionAnimation^ = new GroupCaptionAnimation^(new GroupCaptionState^(vistaColors.GroupText));
        var lastAnimation : IGuiAnimation^ = null;
      ]]></ref.Members>
      <ControlTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.CaptionColor-bind>self.VisuallyEnabled ? vistaColors.GroupText : vistaColors.TextDisabled</att.CaptionColor-bind>
        <ev.CaptionColorChanged-eval><![CDATA[{
          self.KillAnimation(self.lastAnimation);
          self.lastAnimation = CompleteColorAnimation(self.animation.CreateAnimation(new GroupCaptionState^(self.CaptionColor), cast UInt64 120), func():void { self.animation.Interpolate(1.0); });
          self.AddAnimation(self.lastAnimation);
        }]]></ev.CaptionColorChanged-eval>
        <SolidBackground ref.Style="generalBackground"/>
        <Bounds AlignmentToParent-bind="{left:0 top:(titleBounds.CachedBounds.y2/2) right:0 bottom:0}">
          <SolidBorder Shape="shapeType:RoundRect radiusX:3 radiusY:3" Color-eval="vistaColors.ContentBorder"/>
          <Bounds AlignmentToParent="left:1 top:1 right:0 bottom:0"><SolidBorder Shape="shapeType:RoundRect radiusX:3 radiusY:3" Color-eval="vistaColors.SplitterLight"/></Bounds>
          <Bounds ref.Name="container" AlignmentToParent-bind="{left:1 top:(1+titleBounds.CachedBounds.y2/2) right:1 bottom:1}"/>
        </Bounds>
        <Bounds ref.Name="titleBounds" AlignmentToParent="left:5 top:0 right:-1 bottom:-1">
          <SolidBackground ref.Style="generalBackground"/>
          <Bounds AlignmentToParent="left:2 top:0 right:2 bottom:0">
            <SolidLabel Text-bind="self.Text" Color-bind="self.animation.Current.Text" Font-bind="self.Font" VerticalAlignment="Center"/>
          </Bounds>
        </Bounds>
      </ControlTemplate>
    </Instance>
  </Instance>

  <Instance name="LabelTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="winvistaskin::LabelTemplate" ref.Styles="res://WinVistaSkin/Style">
      <LabelTemplate ref.Name="self" ref.Style="labelDefaultText" MinSizeLimitation="LimitToElementAndChildren">
        <SolidLabel Text-bind="self.Text" Font-bind="self.Font" ref.Style="labelText"/>
      </LabelTemplate>
    </Instance>
  </Instance>

  <Instance name="ShortcutKeyTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="winvistaskin::ShortcutKeyTemplate" ref.Styles="res://WinVistaSkin/Style">
      <LabelTemplate ref.Name="self" ref.Style="labelDefaultText" MinSizeLimitation="LimitToElementAndChildren">
        <SolidBorder Color-eval="vistaColors.TooltipBorder"/>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
          <SolidBackground Color-eval="vistaColors.TooltipBackground"/>
          <Bounds AlignmentToParent="left:0 top:0 right:1 bottom:0">
            <SolidLabel Text-bind="self.Text" Font-bind="self.Font" Color-bind="self.TextColor"/>
          </Bounds>
        </Bounds>
      </LabelTemplate>
    </Instance>
  </Instance>

  <Instance name="DateButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="winvistaskin::DateButtonTemplate" xmlns:x="winvistaskin::*">
      <x:ItemBackgroundTemplate ref.Name="self">
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1" Visible-bind="self.Focused">
          <FocusRectangle/>
        </Bounds>
      </x:ItemBackgroundTemplate>
    </Instance>
  </Instance>

  <Instance name="DatePickerTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="winvistaskin::DatePickerTemplate" ref.Styles="res://WinVistaSkin/Style">
      <DatePickerTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren" Date-bind="look.Date">
        <CommonDatePickerLook ref.Name="look" ref.Style="datePickerColors" AlignmentToParent="left:0 top:0 right:0 bottom:0" Font-bind="self.Font" Date-bind="self.Date" DateLocale-bind="self.DateLocale" Commands-bind="self.Commands">
          <att.DateButtonTemplate>winvistaskin::DateButtonTemplate</att.DateButtonTemplate>
          <att.DateTextListTemplate>winvistaskin::TextListTemplate</att.DateTextListTemplate>
          <att.DateComboBoxTemplate>winvistaskin::ComboBoxTemplate</att.DateComboBoxTemplate>
        </CommonDatePickerLook>
      </DatePickerTemplate>
    </Instance>
  </Instance>
</Folder>
