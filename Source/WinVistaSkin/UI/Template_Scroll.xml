        var lastAnimation : IGuiAnimation^ = null;

        func UpdateColors() : void
        {
          KillAnimation(lastAnimation);
          lastAnimation = CompleteColorAnimation(animationBuilder.CreateAnimation(new ButtonColorState^(GetButtonColors(self.VisuallyEnabled, self.State)), cast UInt64 120), func():void { animationBuilder.Interpolate(1.0); });
          AddAnimation(lastAnimation);
        }
      ]]></ref.Members>
      <ButtonTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren">
        <ev.StateChanged-eval>self.UpdateColors();</ev.StateChanged-eval>
        <ev.VisuallyEnabledChanged-eval>self.UpdateColors();</ev.VisuallyEnabledChanged-eval>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
          <SolidBackground Color-bind="self.animationBuilder.Current.Background"/>
        </Bounds>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <SolidBorder Color-bind="self.animationBuilder.Current.Border" Shape="shapeType:RoundRect radiusX:2 radiusY:2"/>
        </Bounds>
        <Table AlignmentToParent="left:2 top:2 right:2 bottom:2">
          <att.Rows>
            <CellOption>composeType:Percentage percentage:1.0</CellOption>
          </att.Rows>
          <att.Columns>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
          </att.Columns>
          <Cell Site="row:0 column:0">
            <GradientBackground Direction="Horizontal" Color1-bind="self.animationBuilder.Current.G1" Color2-bind="self.animationBuilder.Current.G2"/>
          </Cell>
          <Cell Site="row:0 column:1">
            <GradientBackground Direction="Horizontal" Color1-bind="self.animationBuilder.Current.G3" Color2-bind="self.animationBuilder.Current.G4"/>
          </Cell>
        </Table>
      </ButtonTemplate>
    </Instance>
