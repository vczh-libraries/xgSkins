<Folder>
  <Instance name="CustomControlTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="winvistaskin::CustomControlTemplate" ref.Styles="res://WinVistaSkin/Style">
      <ControlTemplate MinSizeLimitation="LimitToElementAndChildren"/>
    </Instance>
  </Instance>

  <Instance name="TooltipTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="winvistaskin::TooltipTemplate" ref.Styles="res://WinVistaSkin/Style">
      <WindowTemplate ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <SolidBackground Color-eval="vistaColors.TooltipBackground"/>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <SolidBorder ref.Style="tooltipBorder"/>
          <Bounds ref.Name="container" AlignmentToParent="left:1 top:1 right:1 bottom:1"/>
        </Bounds>
      </WindowTemplate>
    </Instance>
  </Instance>

  <Instance name="SystemFrameWindowTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="winvistaskin::SystemFrameWindowTemplate" ref.Styles="res://WinVistaSkin/Style">
      <WindowTemplate ContainerComposition-ref="container" CustomFrameEnabled="false" MinSizeLimitation="LimitToElementAndChildren">
        <SolidBackground ref.Style="generalBackground"/>
        <Bounds ref.Name="container" AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
      </WindowTemplate>
    </Instance>
  </Instance>

  <Instance name="CustomFrameWindowTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="winvistaskin::CustomFrameWindowTemplate" ref.Styles="res://WinVistaSkin/Style">
      <WindowTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.CustomFrameEnabled>true</att.CustomFrameEnabled>
        <att.TooltipTemplate>winvistaskin::TooltipTemplate</att.TooltipTemplate>

        <ev.TitleBarChanged-eval>
          <![CDATA[
            {
              if (self.TitleBar)
              {
                contentTable.SetRowOption(0, {composeType:MinSize});
              }
              else
              {
                contentTable.SetRowOption(0, {composeType:Absolute absolute:0});
              }
            }
          ]]>
        </ev.TitleBarChanged-eval>

        <ev.CustomFramePaddingChanged-eval>
          <![CDATA[
            {
              var padding = self.CustomFramePadding;
              var margin = {left:(padding.left > 0 ? 9 : 0); top:padding.top;
                            right:(padding.right > 0 ? 9 : 0); bottom:(padding.bottom > 0 ? 9 : 0);} of Margin;
              contentTable.AlignmentToParent = margin;
              frameTable.SetRowOption(0, {composeType:Absolute absolute:margin.top});
              frameTable.SetRowOption(2, {composeType:Absolute absolute:margin.bottom});
              frameTable.SetColumnOption(0, {composeType:Absolute absolute:margin.left});
              frameTable.SetColumnOption(2, {composeType:Absolute absolute:margin.right});
            }
          ]]>
        </ev.CustomFramePaddingChanged-eval>

        <GradientBackground Direction="Vertical" Color1-bind="self.Activated ? vistaColors.WindowCaptionTop : vistaColors.WindowCaptionInactive" Color2-bind="self.Activated ? vistaColors.WindowCaptionBottom : vistaColors.WindowCaptionInactive"/>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <SolidBorder ref.Style="windowBorder"/>

          <Table AlignmentToParent="left:1 top:1 right:1 bottom:1" Visible-bind="self.Activated">
            <att.Rows><_>composeType:Percentage percentage:1.0</_></att.Rows>
            <att.Columns>
              <_>composeType:Percentage percentage:0.5</_>
              <_>composeType:Percentage percentage:0.5</_>
            </att.Columns>
            <Cell Site="row:0 column:0">
              <GradientBackground Direction="Horizontal" Color1-eval="vistaColors.WindowCaptionTop" Color2-eval="vistaColors.WindowCaptionBottom"/>
            </Cell>
            <Cell Site="row:0 column:1">
              <GradientBackground Direction="Horizontal" Color1-eval="vistaColors.WindowCaptionBottom" Color2-eval="vistaColors.WindowCaptionTop"/>
            </Cell>
          </Table>
          <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:-1" PreferredMinSize="y:12" Visible-bind="self.TitleBar">
            <GradientBackground Direction="Vertical" Color1-eval="vistaColors.CaptionReflection" Color2-eval="vistaColors.CaptionReflectionEdge"/>
          </Bounds>

          <Bounds AlignmentToParent-bind="{left:(self.CustomFramePadding.left &gt; 0 ? 4 : 0) top:(self.CustomFramePadding.top + clientCell.CachedBounds.y1)
                                          right:(self.CustomFramePadding.right &gt; 0 ? 4 : 0) bottom:(self.CustomFramePadding.bottom &gt; 0 ? 4 : 0)}">
            <SolidBackground ref.Style="generalBackground"/>
          </Bounds>

          <Table ref.Name="frameTable" AlignmentToParent="left:0 top:0 right:0 bottom:0">
            <att.Rows>
              <CellOption>composeType:Absolute absolute:0</CellOption>
              <CellOption>composeType:Percentage percentage:1.0</CellOption>
              <CellOption>composeType:Absolute absolute:0</CellOption>
            </att.Rows>
            <att.Columns>
              <CellOption>composeType:Absolute absolute:0</CellOption>
              <CellOption>composeType:Percentage percentage:1.0</CellOption>
              <CellOption>composeType:Absolute absolute:0</CellOption>
            </att.Columns>

            <Cell Site="row:0 column:0" AssociatedHitTestResult="BorderLeftTop"/>
            <Cell Site="row:0 column:2" AssociatedHitTestResult="BorderRightTop"/>
            <Cell Site="row:2 column:0" AssociatedHitTestResult="BorderLeftBottom"/>
            <Cell Site="row:2 column:2" AssociatedHitTestResult="BorderRightBottom"/>

            <Cell Site="row:1 column:0" AssociatedHitTestResult="BorderLeft"/>
            <Cell Site="row:1 column:2" AssociatedHitTestResult="BorderRight"/>
            <Cell Site="row:0 column:1" AssociatedHitTestResult="BorderTop"/>
            <Cell Site="row:2 column:1" AssociatedHitTestResult="BorderBottom"/>
          </Table>

          <Table ref.Name="contentTable" AlignmentToParent="left:0 top:0 right:0 bottom:0">
            <att.Rows>
              <CellOption>composeType:MinSize</CellOption>
              <CellOption>composeType:Percentage percentage:1.0</CellOption>
            </att.Rows>
            <att.Columns>
              <CellOption>composeType:MinSize</CellOption>
              <CellOption>composeType:Percentage percentage:1.0</CellOption>
              <CellOption>composeType:MinSize</CellOption>
              <CellOption>composeType:MinSize</CellOption>
              <CellOption>composeType:MinSize</CellOption>
            </att.Columns>

            <Cell Site="row:0 column:2">
              <att.AssociatedHitTestResult-bind>self.MinimizedBox ? ButtonMinimum : NoDecision</att.AssociatedHitTestResult-bind>
              <Button AutoFocus="false" ControlTemplate="winvistaskin::CaptionButtonTemplate">
                <att.BoundsComposition-set AlignmentToParent="left:1 top:1 right:1 bottom:1"/>
                <att.Enabled-bind>self.MinimizedBox</att.Enabled-bind>
                <att.Visible-bind>self.MinimizedBox or self.MaximizedBox</att.Visible-bind>
                <att.ContainerComposition-set>
                  <BoundsComposition AlignmentToParent="left:0 top:0 right:0 bottom:0" PreferredMinSize="x:24 y:16" MinSizeLimitation="LimitToElement">
                    <Polygon BorderColor-bind="self.VisuallyEnabled and self.MinimizedBox ? vistaColors.CaptionButtonGlyph : vistaColors.TextDisabled" BackgroundColor-bind="self.VisuallyEnabled and self.MinimizedBox ? vistaColors.CaptionButtonGlyph : vistaColors.TextDisabled" Size="x:24 y:16">
                      <att.Points>
                        <Point>x:8 y:12</Point>
                        <Point>x:15 y:12</Point>
                        <Point>x:15 y:13</Point>
                        <Point>x:8 y:13</Point>
                      </att.Points>
                    </Polygon>
                  </BoundsComposition>
                </att.ContainerComposition-set>
              </Button>
            </Cell>
            <Cell Site="row:0 column:3">
              <att.AssociatedHitTestResult-bind>self.MaximizedBox ? ButtonMaximum : NoDecision</att.AssociatedHitTestResult-bind>
              <Button AutoFocus="false" ControlTemplate="winvistaskin::CaptionButtonTemplate">
                <att.BoundsComposition-set AlignmentToParent="left:1 top:1 right:1 bottom:1"/>
                <att.Enabled-bind>self.MaximizedBox</att.Enabled-bind>
                <att.Visible-bind>self.MinimizedBox or self.MaximizedBox</att.Visible-bind>
                <att.ContainerComposition-set>
                  <BoundsComposition Visible-bind="not self.Maximized" AlignmentToParent="left:0 top:0 right:0 bottom:0" PreferredMinSize="x:24 y:16" MinSizeLimitation="LimitToElement">
                    <Polygon BorderColor-bind="self.VisuallyEnabled and self.MaximizedBox ? vistaColors.CaptionButtonGlyph : vistaColors.TextDisabled" BackgroundColor-bind="self.VisuallyEnabled and self.MaximizedBox ? vistaColors.CaptionButtonGlyph : vistaColors.TextDisabled" Size="x:24 y:16">
                      <att.Points>
                        <Point>x:6 y:2</Point>
                        <Point>x:17 y:2</Point>
                        <Point>x:17 y:13</Point>
                        <Point>x:6 y:13</Point>
                        <Point>x:6 y:2</Point>

                        <Point>x:6 y:2</Point>
                        <Point>x:6 y:13</Point>
                        <Point>x:17 y:13</Point>
                        <Point>x:17 y:4</Point>
                        <Point>x:6 y:4</Point>
                      </att.Points>
                    </Polygon>
                  </BoundsComposition>
                  <BoundsComposition Visible-bind="self.Maximized" AlignmentToParent="left:0 top:0 right:0 bottom:0" PreferredMinSize="x:24 y:16" MinSizeLimitation="LimitToElement">
                    <Polygon BorderColor-bind="self.VisuallyEnabled and self.MaximizedBox ? vistaColors.CaptionButtonGlyph : vistaColors.TextDisabled" BackgroundColor-bind="self.VisuallyEnabled and self.MaximizedBox ? vistaColors.CaptionButtonGlyph : vistaColors.TextDisabled" Size="x:24 y:16">
                      <att.Points>
                        <Point>x:9 y:6</Point>
                        <Point>x:14 y:6</Point>
                        <Point>x:14 y:13</Point>
                        <Point>x:6 y:13</Point>
                        <Point>x:6 y:6</Point>
                        <Point>x:9 y:6</Point>

                        <Point>x:9 y:7</Point>
                        <Point>x:6 y:7</Point>
                        <Point>x:6 y:13</Point>
                        <Point>x:14 y:13</Point>
                        <Point>x:14 y:7</Point>
                        <Point>x:9 y:7</Point>

                        <Point>x:9 y:2</Point>
                        <Point>x:17 y:2</Point>
                        <Point>x:17 y:9</Point>
                        <Point>x:14 y:9</Point>

                        <Point>x:14 y:9</Point>
                        <Point>x:17 y:9</Point>
                        <Point>x:17 y:3</Point>
                        <Point>x:9 y:3</Point>
                      </att.Points>
                    </Polygon>
                  </BoundsComposition>
                </att.ContainerComposition-set>
              </Button>
            </Cell>
            <Cell Site="row:0 column:4" AssociatedHitTestResult="ButtonClose">
              <Button AutoFocus="false" ControlTemplate="winvistaskin::CaptionCloseButtonTemplate">
                <att.BoundsComposition-set AlignmentToParent="left:1 top:1 right:1 bottom:1"/>
                <att.ContainerComposition-set>
                  <BoundsComposition AlignmentToParent="left:0 top:0 right:0 bottom:0" PreferredMinSize="x:42 y:16" MinSizeLimitation="LimitToElement">
                    <Polygon BorderColor-eval="vistaColors.WindowCloseText" BackgroundColor-eval="vistaColors.WindowCloseText" Size="x:24 y:16">
                      <att.Points>
                        <Point>x:7 y:2</Point>
                        <Point>x:11 y:6</Point>
                        <Point>x:12 y:6</Point>
                        <Point>x:16 y:2</Point>

                        <Point>x:17 y:3</Point>
                        <Point>x:13 y:7</Point>
                        <Point>x:13 y:8</Point>
                        <Point>x:17 y:12</Point>

                        <Point>x:16 y:13</Point>
                        <Point>x:12 y:9</Point>
                        <Point>x:11 y:9</Point>
                        <Point>x:7 y:13</Point>

                        <Point>x:6 y:12</Point>
                        <Point>x:10 y:8</Point>
                        <Point>x:10 y:7</Point>
                        <Point>x:6 y:3</Point>
                      </att.Points>
                    </Polygon>
                  </BoundsComposition>
                </att.ContainerComposition-set>
              </Button>
            </Cell>

            <Cell Site="row:0 column:0" MinSizeLimitation-bind="((self.Icon is not null) and self.IconVisible ? LimitToElementAndChildren : NoLimit) of (GuiGraphicsComposition::MinSizeLimitation)">
              <Table AlignmentToParent="left:0 top:0 right:2 bottom:0" MinSizeLimitation="LimitToElementAndChildren">
                <att.Rows>
                  <CellOption>composeType:Percentage percentage:1.0</CellOption>
                  <CellOption>composeType:Absolute absolute:16</CellOption>
                  <CellOption>composeType:Percentage percentage:1.0</CellOption>
                </att.Rows>
                <att.Columns>
                  <CellOption>composeType:Absolute absolute:16</CellOption>
                </att.Columns>

                <Cell Site="row:1 column:0" AssociatedHitTestResult="Icon">
                  <ImageFrame Stretch="true" Image-bind="self.Icon is not null ? self.Icon.Image : null" FrameIndex-bind="self.Icon is not null ? self.Icon.FrameIndex : -1"/>
                </Cell>
              </Table>
            </Cell>
            <Cell Site="row:0 column:1" AssociatedHitTestResult="Title">
              <Bounds AlignmentToParent="left:6 top:6 right:4 bottom:4">
                <SolidLabel Color-eval="vistaColors.CaptionHalo" VerticalAlignment="Center" Text-bind="self.Text" Ellipse="true" Font-bind="self.Font"/>
              </Bounds>
              <Bounds AlignmentToParent="left:5 top:5 right:5 bottom:5">
                <SolidLabel ref.Style="windowTitle" Text-bind="self.Text" Ellipse="true" Font-bind="self.Font"/>
              </Bounds>
            </Cell>
            <Cell ref.Name="clientCell" Site="row:1 column:0 columnSpan:5" AssociatedHitTestResult="Client">
              <Bounds ref.Name="container" AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
            </Cell>
          </Table>
        </Bounds>
      </WindowTemplate>
    </Instance>
  </Instance>
  <Instance name="CaptionButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="winvistaskin::CaptionButtonTemplate" ref.Styles="res://WinVistaSkin/Style">
      <ButtonTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <GradientBackground Direction="Vertical" Color1-bind="not self.VisuallyEnabled ? vistaColors.WindowCaptionInactive : self.State == ButtonState::Pressed ? vistaColors.ScrollHandlePressed : self.State == ButtonState::Active ? vistaColors.CaptionButtonHotTop : vistaColors.CaptionButtonTop" Color2-bind="not self.VisuallyEnabled ? vistaColors.WindowCaptionInactive : self.State == ButtonState::Pressed ? vistaColors.ScrollHandlePressed : self.State == ButtonState::Active ? vistaColors.CaptionButtonHotBottom : vistaColors.CaptionButtonBottom"/>
        <SideAligned Direction="Top" MaxLength="12" MaxRatio="0.48">
          <GradientBackground Direction="Vertical" Color1-eval="vistaColors.CaptionReflection" Color2-eval="vistaColors.CaptionReflectionEdge"/>
        </SideAligned>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0"><SolidBorder Shape="shapeType:RoundRect radiusX:2 radiusY:2" Color-bind="self.VisuallyEnabled ? vistaColors.WindowBorderActive : vistaColors.GeneralBorder"/></Bounds>
        <Bounds ref.Name="container" AlignmentToParent="left:2 top:0 right:2 bottom:2"/>
      </ButtonTemplate>
    </Instance>
  </Instance>
  <Instance name="CaptionCloseButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="winvistaskin::CaptionCloseButtonTemplate" ref.Styles="res://WinVistaSkin/Style">
      <ButtonTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <GradientBackground Direction="Vertical" Color1-bind="not self.VisuallyEnabled ? vistaColors.WindowCaptionInactive : self.State == ButtonState::Pressed ? vistaColors.WindowClosePressed : self.State == ButtonState::Active ? vistaColors.WindowCloseHovered : vistaColors.WindowCloseTop" Color2-bind="not self.VisuallyEnabled ? vistaColors.WindowCaptionInactive : self.State == ButtonState::Pressed ? vistaColors.WindowClosePressed : self.State == ButtonState::Active ? vistaColors.WindowCloseHovered : vistaColors.WindowCloseBottom"/>
        <SideAligned Direction="Top" MaxLength="12" MaxRatio="0.48">
          <GradientBackground Direction="Vertical" Color1-eval="vistaColors.CaptionReflection" Color2-eval="vistaColors.CaptionReflectionEdge"/>
        </SideAligned>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0"><SolidBorder Shape="shapeType:RoundRect radiusX:2 radiusY:2" Color-bind="self.VisuallyEnabled ? vistaColors.WindowCloseBorder : vistaColors.GeneralBorder"/></Bounds>
        <Bounds ref.Name="container" AlignmentToParent="left:2 top:0 right:2 bottom:2"/>
      </ButtonTemplate>
    </Instance>
  </Instance>
</Folder>
