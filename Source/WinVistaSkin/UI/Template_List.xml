              <Polygon Size="x:6 y:11" BorderColor-bind="self.VisuallyEnabled and self.State != ButtonState::Normal ? vistaColors.TreeArrowBorderHovered : self.Selected ? vistaColors.TreeArrowBorderExpanded : vistaColors.TreeArrowBorder" BackgroundColor-bind="self.VisuallyEnabled and self.State != ButtonState::Normal ? vistaColors.TreeArrowBackgroundHovered : self.Selected ? vistaColors.TreeArrowBackgroundExpanded : vistaColors.TreeArrowBackground">
