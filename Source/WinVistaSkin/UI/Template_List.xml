<Folder>
  <Instance name="ItemBackgroundTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="winvistaskin::ItemBackgroundTemplate" ref.Styles="res://WinVistaSkin/Style">
      <ref.Members><![CDATA[prop Colors : ButtonColors = vistaColors.ItemNormal {}]]></ref.Members>
      <SelectableButtonTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.Colors-bind>not self.VisuallyEnabled ? vistaColors.ItemDisabled : self.Selected or self.State == ButtonState::Pressed ? vistaColors.ItemSelected : self.State == ButtonState::Active ? vistaColors.ItemHovered : vistaColors.ItemNormal</att.Colors-bind>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
          <SolidBackground Color-bind="self.Colors.Background"/>
        </Bounds>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <SolidBorder Color-bind="self.Colors.Border" Shape="shapeType:RoundRect radiusX:2 radiusY:2"/>
        </Bounds>
        <Table AlignmentToParent="left:2 top:2 right:2 bottom:2">
          <att.Rows>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
          </att.Rows>
          <att.Columns><CellOption>composeType:Percentage percentage:1.0</CellOption></att.Columns>
          <Cell Site="row:0 column:0"><GradientBackground Direction="Vertical" Color1-bind="self.Colors.G1" Color2-bind="self.Colors.G2"/></Cell>
          <Cell Site="row:1 column:0"><GradientBackground Direction="Vertical" Color1-bind="self.Colors.G3" Color2-bind="self.Colors.G4"/></Cell>
        </Table>
        <Bounds ref.Name="container" AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
      </SelectableButtonTemplate>
    </Instance>
  </Instance>

