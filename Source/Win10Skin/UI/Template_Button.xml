<Folder>
  <Script name="ButtonStates">
    <Workflow><![CDATA[
    module Win10ButtonStates;
    using presentation::*;
    using presentation::controls::*;
    namespace win10skin
    {
      func GetButtonColors(enabled : bool, state : ButtonState) : StateColors
      {
        return not enabled ? win10Colors.ButtonDisabled :
          state == ButtonState::Pressed ? win10Colors.ButtonPressed :
          state == ButtonState::Active ? win10Colors.ButtonHovered : win10Colors.ButtonNormal;
      }

      func GetScrollArrowColors(enabled : bool, state : ButtonState) : StateColors
      {
        return not enabled ? win10Colors.CommandDisabled :
          state == ButtonState::Pressed ? win10Colors.CommandPressed :
          state == ButtonState::Active ? win10Colors.CommandHovered : win10Colors.CommandNormal;
      }

      func GetSelectionColors(enabled : bool, state : ButtonState, selected : bool, radio : bool) : StateColors
      {
        if (not enabled)
        {
          return {Border: win10Colors.DisabledText; Fill: win10Colors.Transparent; Text: win10Colors.DisabledText;};
        }
        var border = state == ButtonState::Active ? win10Colors.Text : win10Colors.StrongOutline;
        var fill = win10Colors.Transparent;
        if (state == ButtonState::Pressed)
        {
          border = win10Colors.Outline;
          if (not radio) { fill = border; }
        }
        else if (selected)
        {
          if (radio or state == ButtonState::Normal) { border = win10Colors.Accent; }
          if (not radio) { fill = win10Colors.Accent; }
        }
        return {Border: border; Fill: fill; Text: win10Colors.Text;};
      }
    }
    ]]></Workflow>
  </Script>

  <Instance name="ButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win10skin::ButtonTemplate" ref.Styles="res://Win10Skin/Style">
      <ref.Members><![CDATA[
        prop Colors : StateColors = win10Colors.ButtonNormal {}
      ]]></ref.Members>
      <ButtonTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.Colors-bind>GetButtonColors(self.VisuallyEnabled, self.State)</att.Colors-bind>
        <SolidBackground Color-bind="self.Colors.Border"/>
        <Bounds AlignmentToParent="left:2 top:2 right:2 bottom:2">
          <SolidBackground Color-bind="self.Colors.Fill"/>
        </Bounds>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1" Visible-bind="self.Focused">
          <FocusRectangle/>
        </Bounds>
        <Bounds AlignmentToParent="left:8 top:4 right:8 bottom:4">
          <SolidLabel Color-bind="self.Colors.Text" Text-bind="self.Text" Font-bind="self.Font" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Bounds ref.Name="container" AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
        </Bounds>
      </ButtonTemplate>
    </Instance>
  </Instance>

  <Instance name="CheckBoxTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win10skin::CheckBoxTemplate" ref.Styles="res://Win10Skin/Style">
      <ref.Members><![CDATA[
        prop Colors : StateColors = win10Colors.InputNormal {}
      ]]></ref.Members>
      <SelectableButtonTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.Colors-bind>GetSelectionColors(self.VisuallyEnabled, self.State, self.Selected, false)</att.Colors-bind>
        <Table AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <att.Rows>
            <CellOption>composeType:Percentage percentage:1.0</CellOption>
            <CellOption>composeType:Absolute absolute:20</CellOption>
            <CellOption>composeType:Percentage percentage:1.0</CellOption>
          </att.Rows>
          <att.Columns>
            <CellOption>composeType:Absolute absolute:24</CellOption>
            <CellOption>composeType:Percentage percentage:1.0</CellOption>
          </att.Columns>

          <Cell Site="row:1 column:0">
            <Bounds AlignmentToParent="left:2 top:0 right:2 bottom:0">
              <SolidBackground Color-bind="self.Colors.Fill"/>
              <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
                <SolidBorder Color-bind="self.Colors.Border"/>
              </Bounds>
              <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
                <SolidBorder Color-bind="self.Colors.Border"/>
              </Bounds>
              <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0" Visible-bind="self.Selected">
                <SolidLabel Text="" Font="fontFamily:&quot;Segoe MDL2 Assets&quot; size:20" Color-bind="self.VisuallyEnabled ? win10Colors.OnAccent : win10Colors.DisabledText" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Bounds>
            </Bounds>
          </Cell>

          <Cell Site="row:0 column:1 rowSpan:3 columnSpan:1">
            <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
              <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0" Visible-bind="self.Focused">
                <FocusRectangle/>
              </Bounds>
              <Bounds AlignmentToParent="left:3 top:3 right:3 bottom:3">
                <SolidLabel Color-bind="self.Colors.Text" Text-bind="self.Text" Font-bind="self.Font" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Bounds ref.Name="container" AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
              </Bounds>
            </Bounds>
          </Cell>
        </Table>
      </SelectableButtonTemplate>
    </Instance>
  </Instance>

  <Instance name="RadioButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win10skin::RadioButtonTemplate" ref.Styles="res://Win10Skin/Style">
      <ref.Members><![CDATA[
        prop Colors : StateColors = win10Colors.InputNormal {}
      ]]></ref.Members>
      <SelectableButtonTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.Colors-bind>GetSelectionColors(self.VisuallyEnabled, self.State, self.Selected, true)</att.Colors-bind>
        <Table AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <att.Rows>
            <CellOption>composeType:Percentage percentage:1.0</CellOption>
            <CellOption>composeType:Absolute absolute:20</CellOption>
            <CellOption>composeType:Percentage percentage:1.0</CellOption>
          </att.Rows>
          <att.Columns>
            <CellOption>composeType:Absolute absolute:24</CellOption>
            <CellOption>composeType:Percentage percentage:1.0</CellOption>
          </att.Columns>

          <Cell Site="row:1 column:0">
            <Bounds AlignmentToParent="left:2 top:0 right:2 bottom:0">
              <SolidBackground Color-bind="self.Colors.Fill" Shape="shapeType:Ellipse"/>
              <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
                <SolidBorder Color-bind="self.Colors.Border" Shape="shapeType:Ellipse"/>
              </Bounds>
              <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
                <SolidBorder Color-bind="self.Colors.Border" Shape="shapeType:Ellipse"/>
              </Bounds>
              <Bounds AlignmentToParent="left:5 top:5 right:5 bottom:5" Visible-bind="self.Selected">
                <SolidBackground Shape="shapeType:Ellipse" Color-bind="not self.VisuallyEnabled ? win10Colors.DisabledText : self.State == ButtonState::Normal ? win10Colors.StrongOutline : win10Colors.Text"/>
              </Bounds>
            </Bounds>
          </Cell>

          <Cell Site="row:0 column:1 rowSpan:3 columnSpan:1">
            <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
              <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0" Visible-bind="self.Focused">
                <FocusRectangle/>
              </Bounds>
              <Bounds AlignmentToParent="left:3 top:3 right:3 bottom:3">
                <SolidLabel Color-bind="self.Colors.Text" Text-bind="self.Text" Font-bind="self.Font" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Bounds ref.Name="container" AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
              </Bounds>
            </Bounds>
          </Cell>
        </Table>
      </SelectableButtonTemplate>
    </Instance>
  </Instance>
</Folder>
