<Styles>
  <Style ref.Path="(//Bounds + //Table + //RepeatStack + //RepeatFlow)" MinSizeLimitation="LimitToElementAndChildren"/>
  <Style ref.Path="//*.generalBackground" Color-eval="win10skin::win10Colors.Page"/>
  <Style ref.Path="//*.windowBorder" Color-bind="self.VisuallyEnabled and self.Activated ? win10skin::win10Colors.WindowEdge : win10skin::win10Colors.WindowEdgeInactive"/>
  <Style ref.Path="//*.windowTitle">
    <att.Color-bind>
      <![CDATA[
        cast Color (
          self.VisuallyEnabled and self.Activated ? win10skin::win10Colors.Text :
          win10skin::win10Colors.DisabledText
        )
      ]]>
    </att.Color-bind>
  </Style>
  <Style ref.Path="//*.tooltipBorder" Color-eval="win10skin::win10Colors.Outline"/>
  <Style ref.Path="//*.labelDefaultText" DefaultTextColor-eval="win10skin::win10Colors.Text"/>
  <Style ref.Path="//*.labelText">
    <att.Color-bind>
      <![CDATA[
        cast Color (
          not self.VisuallyEnabled ? win10skin::win10Colors.DisabledText :
          self.TextColor
        )
      ]]>
    </att.Color-bind>
  </Style>
  <Style ref.Path="//*.datePickerColors">
    <att.BackgroundColor-eval>win10skin::win10Colors.Page</att.BackgroundColor-eval>
    <att.PrimaryTextColor-eval>win10skin::win10Colors.Text</att.PrimaryTextColor-eval>
    <att.SecondaryTextColor-eval>win10skin::win10Colors.SecondaryText</att.SecondaryTextColor-eval>
  </Style>
  <Style ref.Path="//*.listBorder">
    <att.Color-bind>
      <![CDATA[
        cast Color (
          not self.VisuallyEnabled ? win10skin::win10Colors.Divider :
          self.Focused ? win10skin::win10Colors.Accent :
          win10skin::win10Colors.Outline
        )
      ]]>
    </att.Color-bind>
  </Style>
  <Style ref.Path="//*.textListBackgroundAndColor">
    <att.TextColor-eval>win10skin::win10Colors.Text</att.TextColor-eval>
    <SolidBackground Color-eval="win10skin::win10Colors.Page"/>
  </Style>
  <Style ref.Path="//*.listViewBackgroundAndColor">
    <att.PrimaryTextColor-eval>win10skin::win10Colors.Text</att.PrimaryTextColor-eval>
    <att.SecondaryTextColor-eval>win10skin::win10Colors.SecondaryText</att.SecondaryTextColor-eval>
    <att.ItemSeparatorColor-eval>win10skin::win10Colors.Divider</att.ItemSeparatorColor-eval>
    <SolidBackground Color-eval="win10skin::win10Colors.Page"/>
  </Style>
  <Style ref.Path="//*.treeViewBackgroundAndColor">
    <att.TextColor-eval>win10skin::win10Colors.Text</att.TextColor-eval>
    <SolidBackground Color-eval="win10skin::win10Colors.Page"/>
  </Style>
  <Style ref.Path="//*.controlText">
    <att.Color-bind>
      <![CDATA[
        cast Color (
          not self.VisuallyEnabled ? win10skin::win10Colors.DisabledText :
          win10skin::win10Colors.Text
        )
      ]]>
    </att.Color-bind>
  </Style>
  <Style ref.Path="//*.toolstripMenuBackground" Color-eval="win10skin::win10Colors.Chrome"/>
  <Style ref.Path="//*.toolstripMenuBorder" Color-eval="win10skin::win10Colors.Outline"/>
  <Style ref.Path="//*.toolstripSplitter" Color-eval="win10skin::win10Colors.Divider"/>
  <Style ref.Path="//*.toolstripArrow" BorderColor-bind="self.Colors.Text" BackgroundColor-bind="self.Colors.Text"/>
  <Style ref.Path="//*.toolstripSplitArrow" BorderColor-bind="self.VisuallyEnabled ? win10skin::win10Colors.Text : win10skin::win10Colors.DisabledText" BackgroundColor-bind="self.VisuallyEnabled ? win10skin::win10Colors.Text : win10skin::win10Colors.DisabledText"/>
  <Style ref.Path="//*.ribbonGroupBorder" Color-eval="win10skin::win10Colors.Divider"/>
  <Style ref.Path="//*.ribbonGroupTitle" Color-eval="win10skin::win10Colors.SecondaryText"/>
  <Style ref.Path="//*.ribbonMenuBorder" Color-eval="win10skin::win10Colors.Outline"/>
  <Style ref.Path="//*.ribbonExpandableArrow" BorderColor-bind="self.VisuallyEnabled and self.State == ButtonState::Pressed ? win10skin::win10Colors.Text : win10skin::win10Colors.SecondaryText" BackgroundColor-bind="self.VisuallyEnabled and self.State == ButtonState::Pressed ? win10skin::win10Colors.Text : win10skin::win10Colors.SecondaryText"/>
  <Style ref.Path="//*.documentBoxBackgroundAndColor" BaselineDocument-eval="win10skin::CreateBaselineDocument()">
    <att.CaretColor-eval>win10skin::win10Colors.Text</att.CaretColor-eval>
    <SolidBackground Color-eval="win10skin::win10Colors.Page"/>
  </Style>
</Styles>