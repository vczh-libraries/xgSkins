  <Instance name="HScrollTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win10skin::HScrollTemplate" ref.Styles="res://Win10Skin/Style">
      <ref.Ctor>
        <![CDATA[
          {
            behavior.AttachScrollTemplate(self);
            behavior.AttachDecreaseButton(buttonDecrease);
            behavior.AttachIncreaseButton(buttonIncrease);
            behavior.AttachHorizontalScrollHandle(handle);
          }
        ]]>
      </ref.Ctor>
      <ScrollTemplate ref.Name="self" PreferredMinSize="y:16" MinSizeLimitation="LimitToElementAndChildren">
        <CommonScrollBehavior ref.Name="behavior"/>

        <SolidBackground Color-eval="win10skin::win10Colors.Chrome"/>

        <SideAligned MaxLength="16" MaxRatio="0.5" Direction="Left">
          <Button AutoFocus="false" ref.Name="buttonDecrease" ControlTemplate="win10skin::LeftScrollButtonTemplate">
            <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
          </Button>
        </SideAligned>
        <SideAligned MaxLength="16" MaxRatio="0.5" Direction="Right">
          <Button AutoFocus="false" ref.Name="buttonIncrease" ControlTemplate="win10skin::RightScrollButtonTemplate">
            <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
          </Button>
        </SideAligned>
        <Bounds ref.Name="handleContainer" AlignmentToParent="left:16 top:0 right:16 bottom:0" MinSizeLimitation="NoLimit">
          <PartialView ref.Name="handle" PreferredMinSize="x:16" Visible-bind="self.VisuallyEnabled">
            <att.WidthPageSize-bind>self.TotalSize == 0 ? 1.0 : (cast double self.PageSize) / self.TotalSize</att.WidthPageSize-bind>
            <att.WidthRatio-bind>self.TotalSize == 0 ? 0.0 : (cast double self.Position) / self.TotalSize</att.WidthRatio-bind>
            <Button AutoFocus="false" ControlTemplate="win10skin::HScrollHandleTemplate">
              <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
            </Button>
          </PartialView>
        </Bounds>
      </ScrollTemplate>
    </Instance>
  </Instance>

