  <Instance name="HTrackerTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win10skin::HTrackerTemplate" ref.Styles="res://Win10Skin/Style">
      <ref.Members><![CDATA[prop HandleSize : Size = {} {}]]></ref.Members>
      <ref.Ctor>
        <![CDATA[
          {
            behavior.AttachScrollTemplate(self);
            behavior.AttachHorizontalTrackerHandle(handle);
          }
        ]]>
      </ref.Ctor>
      <ScrollTemplate ref.Name="self" PreferredMinSize="x:12 y:4" MinSizeLimitation="LimitToElementAndChildren">
        <att.HandleSize-bind>GetTrackerHandleSize(self.CachedBounds, true)</att.HandleSize-bind>
        <CommonScrollBehavior ref.Name="behavior"/>
        <SolidBackground Color-eval="win10skin::win10Colors.Page"/>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0" Visible-bind="self.Focused">
          <FocusRectangle/>
        </Bounds>
        <PartialView>
          <Table AlignmentToParent-bind="{left:(self.HandleSize.x / 2) top:0 right:(self.HandleSize.x - self.HandleSize.x / 2) bottom:0}">
            <att.Rows>
              <CellOption>composeType:Percentage percentage:0.5</CellOption>
              <CellOption>composeType:Absolute absolute:4</CellOption>
              <CellOption>composeType:Percentage percentage:0.5</CellOption>
            </att.Rows>
            <att.Columns>
              <CellOption>composeType:Percentage percentage:1.0</CellOption>
            </att.Columns>
            <Cell Site="row:1 column:0">
              <Bounds AlignmentToParent="left:0 top:1 right:0 bottom:1">
                <SolidBackground Color-bind="self.VisuallyEnabled ? win10Colors.Outline : win10Colors.Divider"/>
                <PartialView>
                  <att.WidthPageSize-bind>self.TotalSize == 0 ? 0.0 : (cast double self.Position) / self.TotalSize</att.WidthPageSize-bind>
                  <SolidBackground Color-bind="self.VisuallyEnabled ? win10Colors.Accent : win10Colors.DisabledText"/>
                </PartialView>
              </Bounds>
            </Cell>
          </Table>
        </PartialView>
        <PartialView ref.Name="handle" PreferredMinSize-bind="self.HandleSize" WidthPageSize="0">
          <att.WidthRatio-bind>self.TotalSize == 0 ? 0.0 : (cast double self.Position) / self.TotalSize</att.WidthRatio-bind>
          <PartialView WidthRatio="0.5" WidthPageSize="0" HeightRatio="0.5" HeightPageSize="0" PreferredMinSize-bind="GetTrackerGripSize(handle.CachedBounds, true)">
            <Button AutoFocus="false" ControlTemplate="win10skin::HTrackerHandleTemplate">
              <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
            </Button>
          </PartialView>
        </PartialView>
      </ScrollTemplate>
    </Instance>
  </Instance>

