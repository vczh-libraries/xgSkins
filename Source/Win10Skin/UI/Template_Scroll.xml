<Folder>
  <Script name="TrackerGeometry">
    <Workflow><![CDATA[
    module Win10TrackerGeometry;
    using presentation::*;
    namespace win10skin
    {
      func GetTrackerHandleSize(bounds : Rect, horizontal : bool) : Size
      {
        var extent = horizontal ? bounds.x2 - bounds.x1 : bounds.y2 - bounds.y1;
        var length = extent < 24 ? extent / 2 : 12;
        if (horizontal) { return {x:length; y:0;}; }
        return {x:0; y:length;};
      }

      func GetTrackerGripSize(bounds : Rect, horizontal : bool) : Size
      {
        var width = bounds.x2 - bounds.x1;
        var height = bounds.y2 - bounds.y1;
        var thickness = horizontal ? height : width;
        var length = horizontal ? width : height;
        if (thickness > 16) { thickness = 16; }
        if (thickness > 2 * length) { thickness = 2 * length; }
        length = (thickness + 1) / 2;
        if (horizontal) { return {x:length; y:thickness;}; }
        return {x:thickness; y:length;};
      }
    }
    ]]></Workflow>
  </Script>

