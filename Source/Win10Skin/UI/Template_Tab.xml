<Folder>
  <Instance name="TabHeaderButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win10skin::TabHeaderButtonTemplate" ref.Styles="res://Win10Skin/Style">
      <ref.Members>
        <![CDATA[
          prop Vertical: bool = false {}
          prop DecorationAxis: GuiAxis^ = new GuiAxis^(AxisDirection::RightDown) {}
          prop Highlighted: bool = false {}
          prop RibbonHeader: bool = false {}
          prop TabFocused: bool = false {}
          prop Colors : StateColors = win10Colors.CommandNormal {}
        ]]>
      </ref.Members>
      <SelectableButtonTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren">
        <att.Vertical-bind>((cast (TabPage*) self.Context).OwnerTab.TypedControlTemplateObject(false).TabOrder ?? TabPageOrder::Unknown) == TabPageOrder::TopToBottom</att.Vertical-bind>
        <att.DecorationAxis-bind>new GuiAxis^(self.Vertical ? AxisDirection::DownRight : AxisDirection::RightDown)</att.DecorationAxis-bind>
        <att.Highlighted-bind>(cast (RibbonTabPage*) self.Context).Highlighted ?? false</att.Highlighted-bind>
        <att.RibbonHeader-bind>not self.Vertical and (self.Context is RibbonTabPage*)</att.RibbonHeader-bind>
        <att.TabFocused-bind>(cast (TabPage*) self.Context).OwnerTab.Focused ?? false</att.TabFocused-bind>
        <att.Colors-bind>self.VisuallyEnabled and self.State != ButtonState::Normal ? win10Colors.TabHovered : self.RibbonHeader and not self.Selected ? win10Colors.CommandNormal : win10Colors.TabNormal</att.Colors-bind>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <SolidBackground Color-bind="self.RibbonHeader and self.Selected ? win10Colors.RibbonBorder : self.Colors.Border"/>
          <Bounds AlignmentToParent-bind="self.DecorationAxis.VirtualMarginToRealMargin({left:1 top:1 right:1 bottom:(self.Selected ? 0 : 1)})">
            <SolidBackground Color-bind="self.Selected ? (self.RibbonHeader ? win10Colors.RibbonSurface : win10Colors.Page) : self.Colors.Fill"/>
          </Bounds>
        </Bounds>
        <Bounds AlignmentToParent-bind="self.DecorationAxis.VirtualMarginToRealMargin({left:1 top:1 right:1 bottom:-1})" PreferredMinSize-bind="self.DecorationAxis.VirtualSizeToRealSize({x:0 y:2})" Visible-bind="self.Highlighted">
          <SolidBackground Color-bind="self.Selected ? win10Colors.Accent : self.State != ButtonState::Normal ? win10Colors.Accent : win10Colors.ItemSelected.Fill"/>
        </Bounds>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1" Visible-bind="self.Selected and self.TabFocused">
          <FocusRectangle/>
        </Bounds>
        <Bounds AlignmentToParent="left:6 top:3 right:6 bottom:3">
          <SolidLabel Color-bind="self.VisuallyEnabled ? self.Colors.Text : win10Colors.DisabledText" Text-bind="self.Text" Font-bind="self.Font" HorizontalAlignment-bind="self.Vertical ? Alignment::Right : Alignment::Center" VerticalAlignment="Center"/>
        </Bounds>
      </SelectableButtonTemplate>
    </Instance>
  </Instance>

  <Instance name="TabHeaderTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win10skin::TabHeaderTemplate" ref.Styles="res://Win10Skin/Style">
      <ref.Parameter Name="CurrentTabPage" Class="presentation::controls::GuiTabPage"/>
      <ref.Members>
        <![CDATA[
          prop Vertical: bool = false {}
          prop Commands : ITabCommandExecutor* = null {}
          prop FlowItem : GuiFlowItemComposition* = null {}
        ]]>
      </ref.Members>
      <ControlTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren">
        <!-- Leave the page divider visible behind translucent headers at the page edge. -->
        <Bounds>
          <att.AlignmentToParent-bind><![CDATA[
            let item = self.FlowItem in (
              {left:0; top:0; right:(self.Vertical ? 1 : 0); bottom:(
                item is not null and item.Parent is not null and
                item.CachedBounds.y2 == item.Parent.CachedBounds.y2 - item.Parent.CachedBounds.y1 ? 1 : 0
              );} of Margin
            )
          ]]></att.AlignmentToParent-bind>
          <SolidBackground Color-bind="not self.Vertical and (CurrentTabPage is RibbonTabPage*) ? win10Colors.Page : win10Colors.WindowSurface"/>
        </Bounds>
        <CheckBox ControlTemplate="win10skin::TabHeaderButtonTemplate" AutoFocus="false" AutoSelection="false">
          <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
          <att.Context-ref>CurrentTabPage</att.Context-ref>
          <att.Text-bind>CurrentTabPage.Text</att.Text-bind>
          <att.Alt-bind>CurrentTabPage.Alt</att.Alt-bind>
          <att.Selected-bind>CurrentTabPage.OwnerTab.SelectedPage == CurrentTabPage</att.Selected-bind>
          <ev.Clicked-eval>
            <![CDATA[
              {
                self.Commands.ShowTab(CurrentTabPage.OwnerTab.Pages.IndexOf(CurrentTabPage), true);
              }
            ]]>
          </ev.Clicked-eval>
        </CheckBox>
      </ControlTemplate>
    </Instance>
  </Instance>

  <Instance name="TabTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win10skin::TabTemplate" ref.Styles="res://Win10Skin/Style">
      <ref.Members>
        <![CDATA[
          prop Highlighted: bool = false {}
          prop IsRibbon: bool = false {}

          func UpdateTabHeader() : void
          {
            for (flowItem in header.FlowItems)
            {
              var item = cast (TabHeaderTemplate*) flowItem.Children[0];
              if (item.CurrentTabPage == self.SelectedTabPage)
              {
                flowItem.ExtraMargin = {left:2 top:2 right:2 bottom:0};
                header.MoveChild(flowItem, header.Children.Count - 1);
              }
              else
              {
                flowItem.ExtraMargin = {left:0 top:0 right:0 bottom:0};
              }
            }
          }

        ]]>
      </ref.Members>
      <RibbonTabTemplate ref.Name="self" ContainerComposition-ref="container" TabOrder="LeftToRight" MinSizeLimitation="LimitToElementAndChildren">
        <ev.SelectedTabPageChanged-eval>
          <![CDATA[
            {
              self.UpdateTabHeader();
            }
          ]]>
        </ev.SelectedTabPageChanged-eval>
        <att.BeforeHeadersContainer-ref>beforeHeadersContainer</att.BeforeHeadersContainer-ref>
        <att.AfterHeadersContainer-ref>afterHeadersContainer</att.AfterHeadersContainer-ref>
        <att.Highlighted-bind>(cast (RibbonTabPage*) self.SelectedTabPage).Highlighted ?? false</att.Highlighted-bind>

        <Table AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <att.Rows>
            <CellOption>composeType:MinSize</CellOption>
            <CellOption>composeType:Percentage percentage:1.0</CellOption>
          </att.Rows>
          <att.Columns>
            <CellOption>composeType:MinSize</CellOption>
            <CellOption>composeType:Percentage percentage:1.0</CellOption>
            <CellOption>composeType:MinSize</CellOption>
          </att.Columns>

          <Cell ref.Name="beforeHeadersContainer" Site="row:0 column:0">
            <SolidBackground Color-bind="self.IsRibbon ? win10Colors.Page : win10Colors.WindowSurface"/>
            <SideAligned Direction="Bottom" MaxLength="1" MaxRatio="1.0">
              <SolidBackground Color-bind="self.IsRibbon ? win10Colors.RibbonBorder : win10Colors.Divider"/>
            </SideAligned>
          </Cell>
          <Cell ref.Name="afterHeadersContainer" Site="row:0 column:2">
            <SolidBackground Color-bind="self.IsRibbon ? win10Colors.Page : win10Colors.WindowSurface"/>
            <SideAligned Direction="Bottom" MaxLength="1" MaxRatio="1.0">
              <SolidBackground Color-bind="self.IsRibbon ? win10Colors.RibbonBorder : win10Colors.Divider"/>
            </SideAligned>
          </Cell>

          <Cell Site="row:0 column:1">
            <SideAligned Direction="Bottom" MaxLength="1" MaxRatio="1.0">
              <SolidBackground Color-bind="self.IsRibbon ? win10Colors.RibbonBorder : win10Colors.Divider"/>
            </SideAligned>
            <RepeatFlow ref.Name="header" AlignmentToParent="left:0 top:-1 right:0 bottom:0" ExtraMargin="left:2 top:2 right:2 bottom:0">
              <att.ItemTemplate>win10skin::TabHeaderTemplate</att.ItemTemplate>
              <att.ItemSource-bind>self.TabPages</att.ItemSource-bind>
              <ev.ItemInserted-eval>
                <![CDATA[
                  {
                    var flowItem = header.FlowItems[arguments.itemIndex];
                    var item = cast (TabHeaderTemplate*) flowItem.Children[0];
                    item.Commands = self.Commands;
                    item.FlowItem = flowItem;
                    self.UpdateTabHeader();
                  }
                ]]>
              </ev.ItemInserted-eval>
              <ev.ItemRemoved-eval>
                <![CDATA[
                  {
                    self.UpdateTabHeader();
                  }
                ]]>
              </ev.ItemRemoved-eval>
            </RepeatFlow>
          </Cell>
          <Cell Site="row:1 column:0 columnSpan:3">
            <SolidBorder Color-bind="self.IsRibbon ? win10Colors.RibbonBorder : win10Colors.Divider"/>
            <Bounds AlignmentToParent-bind="{left:1 top:(self.SelectedTabPage is null ? 1 : 0) right:1 bottom:1}">
              <SolidBackground Color-bind="self.IsRibbon ? win10Colors.RibbonSurface : win10Colors.Page"/>
            </Bounds>
            <Bounds ref.Name="container" AlignmentToParent="left:1 top:3 right:1 bottom:1"/>
          </Cell>
        </Table>
      </RibbonTabTemplate>
    </Instance>
  </Instance>

  <Instance name="VTabTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win10skin::VTabTemplate" ref.Styles="res://Win10Skin/Style">
      <ref.Members><![CDATA[
        func UpdateHeaderMargin(stackItem : GuiStackItemComposition*) : void
        {
          var item = cast (TabHeaderTemplate*) stackItem.Children[0];
          stackItem.ExtraMargin = item.CurrentTabPage == self.SelectedTabPage
            ? {left:2 top:0 right:0 bottom:0}
            : {left:0 top:0 right:0 bottom:0};
        }
      ]]></ref.Members>
      <RibbonTabTemplate ref.Name="self" TabOrder="TopToBottom" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.BeforeHeadersContainer-ref>beforeHeadersContainer</att.BeforeHeadersContainer-ref>
        <att.AfterHeadersContainer-ref>afterHeadersContainer</att.AfterHeadersContainer-ref>
        <ev.SelectedTabPageChanged-eval><![CDATA[{
          for (stackItem in header.StackItems)
          {
            self.UpdateHeaderMargin(stackItem);
          }
        }]]></ev.SelectedTabPageChanged-eval>
        <Table AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <att.Rows><CellOption>composeType:Percentage percentage:1.0</CellOption></att.Rows>
          <att.Columns>
            <CellOption>composeType:MinSize</CellOption>
            <CellOption>composeType:Percentage percentage:1.0</CellOption>
          </att.Columns>
          <Cell Site="row:0 column:0">
            <SideAligned Direction="Right" MaxLength="1">
              <SolidBackground Color-eval="win10Colors.Divider"/>
            </SideAligned>
            <Table AlignmentToParent="left:0 top:0 right:0 bottom:0">
              <att.Rows>
                <CellOption>composeType:MinSize</CellOption>
                <CellOption>composeType:MinSize</CellOption>
                <CellOption>composeType:Percentage percentage:1.0</CellOption>
              </att.Rows>
              <att.Columns><CellOption>composeType:Percentage percentage:1.0</CellOption></att.Columns>
              <Cell ref.Name="beforeHeadersContainer" Site="row:0 column:0"/>
              <Cell Site="row:1 column:0">
                <RepeatStack ref.Name="header" Direction="Vertical" AlignmentToParent="left:0 top:0 right:0 bottom:0" ExtraMargin="left:2 top:0 right:0 bottom:0">
                  <att.ItemTemplate>win10skin::TabHeaderTemplate</att.ItemTemplate>
                  <att.ItemSource-bind>self.TabPages</att.ItemSource-bind>
                  <ev.ItemInserted-eval><![CDATA[{
                    var stackItem = header.StackItems[arguments.itemIndex];
                    var item = cast (TabHeaderTemplate*) stackItem.Children[0];
                    item.Commands = self.Commands;
                    item.Vertical = true;
                    self.UpdateHeaderMargin(stackItem);
                  }]]></ev.ItemInserted-eval>
                </RepeatStack>
              </Cell>
              <Cell ref.Name="afterHeadersContainer" Site="row:2 column:0"/>
            </Table>
          </Cell>
          <Cell Site="row:0 column:1">
            <SolidBorder Color-eval="win10Colors.Divider"/>
            <Bounds AlignmentToParent-bind="{left:(self.SelectedTabPage is null ? 1 : 0) top:1 right:1 bottom:1}">
              <SolidBackground Color-eval="win10Colors.Page"/>
            </Bounds>
            <Bounds ref.Name="container" AlignmentToParent="left:3 top:1 right:1 bottom:1"/>
          </Cell>
        </Table>
      </RibbonTabTemplate>
    </Instance>
  </Instance>

  <Instance name="RibbonTabTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win10skin::RibbonTabTemplate" xmlns:x="win10skin::*">
      <x:TabTemplate IsRibbon="true"/>
    </Instance>
  </Instance>
</Folder>
