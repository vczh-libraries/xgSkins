  <Instance name="ToolstripButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win10skin::ToolstripButtonTemplate" ref.Styles="res://Win10Skin/Style">
      <ref.Members><![CDATA[
        prop Colors : StateColors = win10Colors.CommandNormal {}
      ]]></ref.Members>
      <ToolstripButtonTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.Colors-bind>not self.VisuallyEnabled ? win10Colors.CommandDisabled : self.State == ButtonState::Pressed or self.SubMenuOpening ? win10Colors.CommandPressed : self.Selected ? win10Colors.ItemSelected : self.State == ButtonState::Active ? win10Colors.CommandHovered : win10Colors.CommandNormal</att.Colors-bind>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0"><SolidBorder Color-bind="self.Colors.Border"/></Bounds>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
          <SolidBackground Color-bind="self.Colors.Fill"/>
        </Bounds>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">

          <Bounds ref.Name="container" AlignmentToParent="left:2 top:2 right:2 bottom:2">
            <ImageFrame Image-bind="self.Image.Image ?? null" FrameIndex-bind="self.Image.FrameIndex ?? 0" Enabled-bind="self.VisuallyEnabled"/>
          </Bounds>
        </Bounds>
      </ToolstripButtonTemplate>
    </Instance>
  </Instance>

  <Instance name="ToolstripDropdownButtonResource">
