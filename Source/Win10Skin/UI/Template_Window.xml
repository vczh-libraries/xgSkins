<Folder>
  <Instance name="CustomControlTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win10skin::CustomControlTemplate" ref.Styles="res://Win10Skin/Style">
      <ControlTemplate MinSizeLimitation="LimitToElementAndChildren"/>
    </Instance>
  </Instance>

  <Instance name="TooltipTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win10skin::TooltipTemplate" ref.Styles="res://Win10Skin/Style">
      <WindowTemplate ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <SolidBackground Color-eval="win10Colors.Chrome"/>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <SolidBorder ref.Style="tooltipBorder"/>
          <Bounds ref.Name="container" AlignmentToParent="left:1 top:1 right:1 bottom:1"/>
        </Bounds>
      </WindowTemplate>
    </Instance>
  </Instance>

  <Instance name="SystemFrameWindowTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win10skin::SystemFrameWindowTemplate" ref.Styles="res://Win10Skin/Style">
      <WindowTemplate ContainerComposition-ref="container" CustomFrameEnabled="false" MinSizeLimitation="LimitToElementAndChildren">
        <SolidBackground Color-eval="win10Colors.WindowSurface"/>
        <Bounds ref.Name="container" AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
      </WindowTemplate>
    </Instance>
  </Instance>

  <Instance name="CustomFrameWindowTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win10skin::CustomFrameWindowTemplate" ref.Styles="res://Win10Skin/Style">
      <WindowTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.CustomFrameEnabled>true</att.CustomFrameEnabled>
        <att.TooltipTemplate>win10skin::TooltipTemplate</att.TooltipTemplate>

        <ev.TitleBarChanged-eval>
          <![CDATA[
            {
              if (self.TitleBar)
              {
                contentTable.SetRowOption(0, {composeType:MinSize});
              }
              else
              {
                contentTable.SetRowOption(0, {composeType:Absolute absolute:0});
              }
            }
          ]]>
        </ev.TitleBarChanged-eval>

        <ev.CustomFramePaddingChanged-eval>
          <![CDATA[
            {
              var padding = self.CustomFramePadding;
              var margin = {left:(padding.left > 0 ? 9 : 0); top:padding.top;
                            right:(padding.right > 0 ? 9 : 0); bottom:(padding.bottom > 0 ? 9 : 0);} of Margin;
              var captionRight = padding.right > 0 ? 4 : 0;
              contentTable.AlignmentToParent = {left:margin.left; top:margin.top; right:captionRight; bottom:margin.bottom;};
              container.AlignmentToParent = {left:0; top:0; right:margin.right - captionRight; bottom:0;};
              frameTable.SetRowOption(0, {composeType:Absolute absolute:margin.top});
              frameTable.SetRowOption(2, {composeType:Absolute absolute:margin.bottom});
              frameTable.SetColumnOption(0, {composeType:Absolute absolute:margin.left});
              frameTable.SetColumnOption(2, {composeType:Absolute absolute:margin.right});
            }
          ]]>
        </ev.CustomFramePaddingChanged-eval>

        <SolidBackground Color-eval="win10Colors.Page"/>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <SolidBorder ref.Style="windowBorder"/>

          <Bounds AlignmentToParent-bind="{left:(self.CustomFramePadding.left &gt; 0 ? 4 : 0) top:(self.CustomFramePadding.top + clientCell.CachedBounds.y1)
                                          right:(self.CustomFramePadding.right &gt; 0 ? 4 : 0) bottom:(self.CustomFramePadding.bottom &gt; 0 ? 4 : 0)}">
            <SolidBackground Color-eval="win10Colors.WindowSurface"/>
          </Bounds>

          <Table ref.Name="frameTable" AlignmentToParent="left:0 top:0 right:0 bottom:0">
            <att.Rows>
              <CellOption>composeType:Absolute absolute:0</CellOption>
              <CellOption>composeType:Percentage percentage:1.0</CellOption>
              <CellOption>composeType:Absolute absolute:0</CellOption>
            </att.Rows>
            <att.Columns>
              <CellOption>composeType:Absolute absolute:0</CellOption>
              <CellOption>composeType:Percentage percentage:1.0</CellOption>
              <CellOption>composeType:Absolute absolute:0</CellOption>
            </att.Columns>

            <Cell Site="row:0 column:0" AssociatedHitTestResult="BorderLeftTop"/>
            <Cell Site="row:0 column:2" AssociatedHitTestResult="BorderRightTop"/>
            <Cell Site="row:2 column:0" AssociatedHitTestResult="BorderLeftBottom"/>
            <Cell Site="row:2 column:2" AssociatedHitTestResult="BorderRightBottom"/>

            <Cell Site="row:1 column:0" AssociatedHitTestResult="BorderLeft"/>
            <Cell Site="row:1 column:2" AssociatedHitTestResult="BorderRight"/>
            <Cell Site="row:0 column:1" AssociatedHitTestResult="BorderTop"/>
            <Cell Site="row:2 column:1" AssociatedHitTestResult="BorderBottom"/>
          </Table>

          <Table ref.Name="contentTable" AlignmentToParent="left:0 top:0 right:0 bottom:0">
            <att.Rows>
              <CellOption>composeType:MinSize</CellOption>
              <CellOption>composeType:Percentage percentage:1.0</CellOption>
            </att.Rows>
            <att.Columns>
              <CellOption>composeType:MinSize</CellOption>
              <CellOption>composeType:Percentage percentage:1.0</CellOption>
              <CellOption>composeType:MinSize</CellOption>
              <CellOption>composeType:MinSize</CellOption>
              <CellOption>composeType:MinSize</CellOption>
            </att.Columns>

            <Cell Site="row:0 column:2">
              <att.AssociatedHitTestResult-bind>self.MinimizedBox ? ButtonMinimum : NoDecision</att.AssociatedHitTestResult-bind>
              <Button AutoFocus="false" ControlTemplate="win10skin::CaptionButtonTemplate">
                <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
                <att.Enabled-bind>self.MinimizedBox</att.Enabled-bind>
                <att.Visible-bind>self.MinimizedBox or self.MaximizedBox</att.Visible-bind>
                <att.ContainerComposition-set>
                  <BoundsComposition AlignmentToParent="left:0 top:0 right:0 bottom:0" PreferredMinSize="x:46 y:32" MinSizeLimitation="LimitToElement">
                    <Polygon Size="x:10 y:10" BorderColor-eval="win10Colors.Transparent" BackgroundColor-bind="self.VisuallyEnabled and self.Activated and self.MinimizedBox ? win10Colors.Text : win10Colors.DisabledText">
                      <att.Points>
                        <Point>x:0 y:4</Point>
                        <Point>x:10 y:4</Point>
                        <Point>x:10 y:5</Point>
                        <Point>x:0 y:5</Point>
                      </att.Points>
                    </Polygon>
                  </BoundsComposition>
                </att.ContainerComposition-set>
              </Button>
            </Cell>
            <Cell Site="row:0 column:3">
              <att.AssociatedHitTestResult-bind>self.MaximizedBox ? ButtonMaximum : NoDecision</att.AssociatedHitTestResult-bind>
              <Button AutoFocus="false" ControlTemplate="win10skin::CaptionButtonTemplate">
                <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
                <att.Enabled-bind>self.MaximizedBox</att.Enabled-bind>
                <att.Visible-bind>self.MinimizedBox or self.MaximizedBox</att.Visible-bind>
                <att.ContainerComposition-set>
                  <BoundsComposition Visible-bind="not self.Maximized" AlignmentToParent="left:0 top:0 right:0 bottom:0" PreferredMinSize="x:46 y:32" MinSizeLimitation="LimitToElement">
                    <Polygon Size="x:10 y:10" BorderColor-bind="self.VisuallyEnabled and self.Activated and self.MaximizedBox ? win10Colors.Text : win10Colors.DisabledText" BackgroundColor-eval="win10Colors.Transparent">
                      <att.Points>
                        <Point>x:0 y:0</Point>
                        <Point>x:9 y:0</Point>
                        <Point>x:9 y:9</Point>
                        <Point>x:0 y:9</Point>
                      </att.Points>
                    </Polygon>
                  </BoundsComposition>
                  <BoundsComposition Visible-bind="self.Maximized" AlignmentToParent="left:0 top:0 right:0 bottom:0" PreferredMinSize="x:46 y:32" MinSizeLimitation="LimitToElement">
                    <Polygon Size="x:10 y:10" BorderColor-bind="self.VisuallyEnabled and self.Activated and self.MaximizedBox ? win10Colors.Text : win10Colors.DisabledText" BackgroundColor-eval="win10Colors.Transparent">
                      <att.Points>
                        <Point>x:7 y:2</Point>
                        <Point>x:2 y:2</Point>
                        <Point>x:2 y:0</Point>
                        <Point>x:9 y:0</Point>
                        <Point>x:9 y:7</Point>
                        <Point>x:7 y:7</Point>
                        <Point>x:7 y:2</Point>
                        <Point>x:0 y:2</Point>
                        <Point>x:0 y:9</Point>
                        <Point>x:7 y:9</Point>
                      </att.Points>
                    </Polygon>
                  </BoundsComposition>
                </att.ContainerComposition-set>
              </Button>
            </Cell>
            <Cell Site="row:0 column:4" AssociatedHitTestResult="ButtonClose">
              <Button AutoFocus="false" ControlTemplate="win10skin::CaptionCloseButtonTemplate">
                <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
              </Button>
            </Cell>

            <Cell Site="row:0 column:0" MinSizeLimitation-bind="((self.Icon is not null) and self.IconVisible ? LimitToElementAndChildren : NoLimit) of (GuiGraphicsComposition::MinSizeLimitation)">
              <Table AlignmentToParent="left:0 top:0 right:2 bottom:0" MinSizeLimitation="LimitToElementAndChildren">
                <att.Rows>
                  <CellOption>composeType:Percentage percentage:1.0</CellOption>
                  <CellOption>composeType:Absolute absolute:16</CellOption>
                  <CellOption>composeType:Percentage percentage:1.0</CellOption>
                </att.Rows>
                <att.Columns>
                  <CellOption>composeType:Absolute absolute:16</CellOption>
                </att.Columns>

                <Cell Site="row:1 column:0" AssociatedHitTestResult="Icon">
                  <ImageFrame Stretch="true" Image-bind="self.Icon is not null ? self.Icon.Image : null" FrameIndex-bind="self.Icon is not null ? self.Icon.FrameIndex : -1"/>
                </Cell>
              </Table>
            </Cell>
            <Cell Site="row:0 column:1" AssociatedHitTestResult="Title">
              <Bounds AlignmentToParent="left:5 top:5 right:5 bottom:5">
                <SolidLabel ref.Style="windowTitle" Text-bind="self.Text" Ellipse="true" Font-bind="self.Font" HorizontalAlignment="Left"/>
              </Bounds>
            </Cell>
            <!-- The exposed strip beside the client completes the nine-pixel right resize area. -->
            <Cell ref.Name="clientCell" Site="row:1 column:0 columnSpan:5" AssociatedHitTestResult="BorderRight">
              <Bounds ref.Name="container" AssociatedHitTestResult="Client" AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
            </Cell>
          </Table>
        </Bounds>
      </WindowTemplate>
    </Instance>
  </Instance>
  <Instance name="CaptionButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win10skin::CaptionButtonTemplate" ref.Styles="res://Win10Skin/Style">
      <ButtonTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <SolidBackground Color-bind="not self.VisuallyEnabled ? win10Colors.Transparent : self.State == ButtonState::Pressed ? win10Colors.CommandPressed.Fill : self.State == ButtonState::Active ? win10Colors.CommandHovered.Fill : win10Colors.Transparent"/>
        <Bounds ref.Name="container" AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
      </ButtonTemplate>
    </Instance>
  </Instance>
  <Instance name="CaptionCloseButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win10skin::CaptionCloseButtonTemplate" ref.Styles="res://Win10Skin/Style">
      <ButtonTemplate ref.Name="self" ContainerComposition-ref="container" PreferredMinSize="x:46 y:32" MinSizeLimitation="LimitToElementAndChildren">
        <SolidBackground Color-bind="not self.VisuallyEnabled ? win10Colors.Transparent : self.State == ButtonState::Pressed ? win10Colors.ClosePressed : self.State == ButtonState::Active ? win10Colors.CloseHovered : win10Colors.Transparent"/>
        <Bounds ref.Name="container" AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <Polygon Size="x:10 y:10" BorderColor-eval="win10Colors.Transparent" BackgroundColor-bind="not self.VisuallyEnabled ? win10Colors.DisabledText : self.State == ButtonState::Normal ? win10Colors.Text : win10Colors.OnAccent">
            <att.Points>
              <Point>x:6 y:5</Point>
              <Point>x:10 y:9</Point>
              <Point>x:9 y:10</Point>
              <Point>x:5 y:6</Point>
              <Point>x:1 y:10</Point>
              <Point>x:0 y:9</Point>
              <Point>x:4 y:5</Point>
              <Point>x:0 y:1</Point>
              <Point>x:1 y:0</Point>
              <Point>x:5 y:4</Point>
              <Point>x:9 y:0</Point>
              <Point>x:10 y:1</Point>
            </att.Points>
          </Polygon>
        </Bounds>
      </ButtonTemplate>
    </Instance>
  </Instance>
</Folder>