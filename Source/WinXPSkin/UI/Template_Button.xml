<Folder>
  <Script name="ButtonColorsScript">
    <Workflow><![CDATA[
    module WinXPButtonColors;
    using presentation::*;
    using presentation::controls::*;
    namespace winxpskin
    {
      struct ButtonColors
      {
        Border : Color;
        Inner : Color;
        G1 : Color;
        G2 : Color;
        Text : Color;
        Bullet : Color;
      }

      func GetButtonColors(enabled : bool, state : ButtonState) : ButtonColors
      {
        return not enabled ? winxpColors.ButtonDisabled :
          state == ButtonState::Pressed ? winxpColors.ButtonPressed :
          state == ButtonState::Active ? winxpColors.ButtonHovered : winxpColors.ButtonNormal;
      }

      func GetCheckedColors(enabled : bool, state : ButtonState, selected : bool) : ButtonColors
      {
        var colors = not enabled ? winxpColors.CheckedDisabled :
          state == ButtonState::Pressed ? winxpColors.CheckedPressed :
          state == ButtonState::Active ? winxpColors.CheckedHovered : winxpColors.CheckedNormal;
        return {
          Border: colors.Border;
          Inner: colors.Inner;
          G1: colors.G1;
          G2: colors.G2;
          Text: colors.Text;
          Bullet: selected ? colors.Bullet : {r:colors.Bullet.r; g:colors.Bullet.g; b:colors.Bullet.b; a:winxpColors.Transparent.a;};
        };
      }

      func GetScrollButtonColors(enabled : bool, state : ButtonState, arrow : bool) : ButtonColors
      {
        if (arrow)
        {
          return not enabled ? winxpColors.ScrollArrowDisabled :
            state == ButtonState::Pressed ? winxpColors.ScrollArrowPressed :
            state == ButtonState::Active ? winxpColors.ScrollArrowActive : winxpColors.ScrollArrowNormal;
        }
        return not enabled ? winxpColors.ScrollHandleDisabled :
          state == ButtonState::Pressed ? winxpColors.ScrollHandlePressed :
          state == ButtonState::Active ? winxpColors.ScrollHandleActive : winxpColors.ScrollHandleNormal;
      }
    }
    ]]></Workflow>
  </Script>

  <Instance name="ButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="winxpskin::ButtonTemplate" ref.Styles="res://WinXPSkin/Style">
      <ref.Members><![CDATA[
        prop Colors : ButtonColors = {} {}
      ]]></ref.Members>
      <ButtonTemplate ref.Name="self" ContainerComposition-ref="container" PreferredMinSize="y:23" MinSizeLimitation="LimitToElementAndChildren">
        <att.Colors-bind>self.VisuallyEnabled and self.State == ButtonState::Normal and self.Focused ? winxpColors.ButtonFocused : GetButtonColors(self.VisuallyEnabled, self.State)</att.Colors-bind>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
          <SolidBackground Color-bind="self.Colors.Inner" Shape="shapeType:RoundRect radiusX:2 radiusY:2"/>
        </Bounds>
        <Bounds AlignmentToParent="left:3 top:3 right:3 bottom:3">
          <GradientBackground Direction="Vertical" Color1-bind="self.Colors.G1" Color2-bind="self.Colors.G2"/>
        </Bounds>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <SolidBorder Color-bind="self.Colors.Border" Shape="shapeType:RoundRect radiusX:2 radiusY:2"/>
        </Bounds>
        <Bounds AlignmentToParent="left:4 top:4 right:4 bottom:4" Visible-bind="self.Focused">
          <FocusRectangle/>
        </Bounds>
        <Bounds AlignmentToParent="left:6 top:3 right:6 bottom:3">
          <SolidLabel Color-bind="self.Colors.Text" Text-bind="self.Text" Font-bind="self.Font" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Bounds ref.Name="container" AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
        </Bounds>
      </ButtonTemplate>
    </Instance>
  </Instance>

  <Instance name="CheckBoxTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="winxpskin::CheckBoxTemplate" ref.Styles="res://WinXPSkin/Style">
      <ref.Members><![CDATA[
        prop Colors : ButtonColors = {} {}
      ]]></ref.Members>
      <SelectableButtonTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.Colors-bind>GetCheckedColors(self.VisuallyEnabled, self.State, self.Selected)</att.Colors-bind>
        <Table AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <att.Rows>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
            <CellOption>composeType:Absolute absolute:13</CellOption>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
          </att.Rows>
          <att.Columns>
            <CellOption>composeType:Absolute absolute:17</CellOption>
            <CellOption>composeType:Percentage percentage:1.0</CellOption>
          </att.Columns>
          <Cell Site="row:1 column:0">
            <Bounds AlignmentToParent="left:2 top:0 right:2 bottom:0">
              <SolidBorder Color-bind="self.Colors.Border"/>
              <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
                <GradientBackground Direction="Slash" Color1-bind="self.Colors.G1" Color2-bind="self.Colors.G2"/>
                <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
                  <SolidBorder Color-bind="self.Colors.Inner"/>
                </Bounds>
              </Bounds>
            </Bounds>
            <Bounds AlignmentToParent="left:4 top:2 right:4 bottom:2" Visible-bind="self.Selected">
              <Polygon Size="x:9 y:9" BorderColor-bind="self.Colors.Bullet" BackgroundColor-bind="self.Colors.Bullet">
                <att.Points>
                  <Point>x:0 y:3</Point>
                  <Point>x:3 y:6</Point>
                  <Point>x:8 y:1</Point>
                  <Point>x:8 y:4</Point>
                  <Point>x:3 y:8</Point>
                  <Point>x:0 y:5</Point>
                </att.Points>
              </Polygon>
            </Bounds>
          </Cell>
          <Cell Site="row:0 column:1 rowSpan:3 columnSpan:1">
            <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0" Visible-bind="self.Focused">
              <FocusRectangle/>
            </Bounds>
            <Bounds AlignmentToParent="left:3 top:3 right:3 bottom:3">
              <SolidLabel Color-bind="self.Colors.Text" Text-bind="self.Text" Font-bind="self.Font" HorizontalAlignment="Left" VerticalAlignment="Center"/>
              <Bounds ref.Name="container" AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
            </Bounds>
          </Cell>
        </Table>
      </SelectableButtonTemplate>
    </Instance>
  </Instance>

  <Instance name="RadioButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="winxpskin::RadioButtonTemplate" ref.Styles="res://WinXPSkin/Style">
      <ref.Members><![CDATA[
        prop Colors : ButtonColors = {} {}
      ]]></ref.Members>
      <SelectableButtonTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.Colors-bind>GetCheckedColors(self.VisuallyEnabled, self.State, self.Selected)</att.Colors-bind>
        <Table AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <att.Rows>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
            <CellOption>composeType:Absolute absolute:13</CellOption>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
          </att.Rows>
          <att.Columns>
            <CellOption>composeType:Absolute absolute:17</CellOption>
            <CellOption>composeType:Percentage percentage:1.0</CellOption>
          </att.Columns>
          <Cell Site="row:1 column:0">
            <Bounds AlignmentToParent="left:2 top:0 right:2 bottom:0">
              <SolidBorder Color-bind="self.Colors.Border" Shape="shapeType:Ellipse"/>
              <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
                <GradientBackground Direction="Slash" Color1-bind="self.Colors.G1" Color2-bind="self.Colors.G2" Shape="shapeType:Ellipse"/>
                <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
                  <SolidBorder Color-bind="self.Colors.Inner" Shape="shapeType:Ellipse"/>
                </Bounds>
              </Bounds>
            </Bounds>
            <Bounds AlignmentToParent="left:5 top:3 right:5 bottom:3" Visible-bind="self.Selected">
              <GradientBackground Direction="Vertical" Color1-bind="self.VisuallyEnabled ? winxpColors.RadioBulletLight : self.Colors.Bullet" Color2-bind="self.Colors.Bullet" Shape="shapeType:Ellipse"/>
            </Bounds>
          </Cell>
          <Cell Site="row:0 column:1 rowSpan:3 columnSpan:1">
            <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0" Visible-bind="self.Focused">
              <FocusRectangle/>
            </Bounds>
            <Bounds AlignmentToParent="left:3 top:3 right:3 bottom:3">
              <SolidLabel Color-bind="self.Colors.Text" Text-bind="self.Text" Font-bind="self.Font" HorizontalAlignment="Left" VerticalAlignment="Center"/>
              <Bounds ref.Name="container" AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
            </Bounds>
          </Cell>
        </Table>
      </SelectableButtonTemplate>
    </Instance>
  </Instance>
</Folder>
