        prop Colors : ButtonColors = winxpColors.ToolstripButtonNormal {}
      ]]></ref.Members>
      <ToolstripButtonTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.Colors-bind>not self.VisuallyEnabled ? winxpColors.ToolstripButtonDisabled : self.State == ButtonState::Pressed or self.SubMenuOpening ? winxpColors.ToolstripButtonPressed : self.Selected ? winxpColors.ToolstripButtonSelected : self.State == ButtonState::Active ? winxpColors.ToolstripButtonActive : winxpColors.ToolstripButtonNormal</att.Colors-bind>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0"><SolidBorder Color-bind="self.Colors.Border"/></Bounds>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
          <GradientBackground Direction="Vertical" Color1-bind="self.Colors.G1" Color2-bind="self.Colors.G2"/>
        </Bounds>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">

          <Bounds ref.Name ="container" AlignmentToParent="left:3 top:3 right:3 bottom:3">
            <ImageFrame Image-bind="self.Image.Image ?? null" FrameIndex-bind="self.Image.FrameIndex ?? 0" Enabled-bind="self.VisuallyEnabled"/>
          </Bounds>
        </Bounds>
      </ToolstripButtonTemplate>
    </Instance>
  </Instance>

