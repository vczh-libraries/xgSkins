  <Instance name="ProgressBarTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="winxpskin::ProgressBarTemplate" ref.Styles="res://WinXPSkin/Style">
      <ref.Members><![CDATA[
        prop RequestedChunkCount : int = 0 {}
        prop ChunkCount : int = 0 {}
        var chunkUpdateState : ProgressChunkUpdateState^ = new ProgressChunkUpdateState^();

        func QueueChunkCount() : void
        {
          var state = chunkUpdateState;
          if (state.Active and not state.Queued)
          {
            state.Queued = true;
            GuiApplication::GetApplication().InvokeInMainThread(self.RelatedControlHost, func():void
            {
              if (state.Active)
              {
                state.Queued = false;
                self.ChunkCount = self.RequestedChunkCount;
              }
            });
          }
        }
      ]]></ref.Members>
      <ref.Dtor><![CDATA[{ chunkUpdateState.Active = false; }]]></ref.Dtor>
      <ScrollTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.RequestedChunkCount-bind><![CDATA[
          (fill.CachedBounds.x2 - fill.CachedBounds.x1 + (self.Position >= self.TotalSize - self.PageSize ? 7 : 1)) / 8
        ]]></att.RequestedChunkCount-bind>
        <ev.RequestedChunkCountChanged-eval>self.QueueChunkCount();</ev.RequestedChunkCountChanged-eval>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1" MinSizeLimitation="NoLimit">
          <SolidBackground Color-eval="winxpskin::winxpColors.ProgressBackground"/>
          <Bounds AlignmentToParent="left:2 top:2 right:2 bottom:2">
            <PartialView ref.Name="fill" MinSizeLimitation="NoLimit">
              <att.WidthPageSize-bind><![CDATA[
                self.Position <= 0 ? 0.0 : self.Position >= self.TotalSize - self.PageSize ? 1.0 :
                (cast double self.Position) / (self.TotalSize - self.PageSize)
              ]]></att.WidthPageSize-bind>
              <RepeatStack AlignmentToParent="left:0 top:0 right:0 bottom:0" Direction="Horizontal" Padding="2" MinSizeLimitation="NoLimit">
                <att.ItemTemplate-eval><![CDATA[
                  func(value : object) : presentation::templates::GuiTemplate*
                  {
                    return new winxpskin::ProgressChunkTemplate*();
                  }
                ]]></att.ItemTemplate-eval>
                <att.ItemSource-bind><![CDATA[
                  range[0, self.ChunkCount)
                ]]></att.ItemSource-bind>
              </RepeatStack>
            </PartialView>
          </Bounds>
        </Bounds>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <SolidBorder Color-eval="winxpskin::winxpColors.ProgressBorder" Shape="shapeType:RoundRect radiusX:2 radiusY:2"/>
        </Bounds>
        <Bounds ref.Name="container" AlignmentToParent="left:1 top:1 right:1 bottom:1"/>
      </ScrollTemplate>
    </Instance>
  </Instance>

