  <Instance name="ExpandingDecoratorTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="winxpskin::ExpandingDecoratorTemplate" ref.Styles="res://WinXPSkin/Style">
      <SelectableButtonTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren" PreferredMinSize="x:13 y:13">
        <Table AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <att.Rows>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
            <CellOption>composeType:Absolute absolute:9</CellOption>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
          </att.Rows>
          <att.Columns>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
            <CellOption>composeType:Absolute absolute:9</CellOption>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
          </att.Columns>
          <Cell Site="row:1 column:1">
            <GradientBackground Direction="Backslash" Color1-eval="winxpColors.TreeGradientTop" Color2-eval="winxpColors.TreeGradientBottom"/>
            <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
              <SolidBorder Color-bind="self.VisuallyEnabled ? winxpColors.TreeBorder : winxpColors.TextDisabled"/>
            </Bounds>
            <Bounds AlignmentToParent="left:2 top:4 right:2 bottom:4"><SolidBackground Color-bind="self.VisuallyEnabled ? winxpColors.TreeGlyph : winxpColors.TextDisabled"/></Bounds>
            <Bounds AlignmentToParent="left:4 top:2 right:4 bottom:2" Visible-bind="not self.Selected"><SolidBackground Color-bind="self.VisuallyEnabled ? winxpColors.TreeGlyph : winxpColors.TextDisabled"/></Bounds>
          </Cell>
        </Table>
      </SelectableButtonTemplate>
    </Instance>
  </Instance>

