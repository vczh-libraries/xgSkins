  <Instance name="ListViewColumnDropDownTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="winxpskin::ListViewColumnDropDownTemplate" ref.Styles="res://WinXPSkin/Style">
      <SelectableButtonTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren" PreferredMinSize="x:13 y:0">
        <Bounds AlignmentToParent="left:0 top:3 right:-1 bottom:4" PreferredMinSize="x:1 y:0">
          <SolidBackground Color-eval="winxpColors.HeaderSeparatorTop"/>
        </Bounds>
        <Bounds AlignmentToParent="left:0 top:1 right:1 bottom:1" Visible-bind="self.VisuallyEnabled and (self.State != ButtonState::Normal or self.Selected)">
          <SolidBorder Color-eval="winxpColors.HeaderBorderPressed"/>
          <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
            <GradientBackground Direction="Vertical" Color1-eval="winxpColors.HeaderDropDownTop" Color2-eval="winxpColors.HeaderDropDownBottom"/>
          </Bounds>
        </Bounds>
        <Table AlignmentToParent="left:3 top:3 right:3 bottom:3">
          <att.Rows>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
            <CellOption>composeType:Absolute absolute:4</CellOption>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
          </att.Rows>
          <att.Columns><CellOption>composeType:Absolute absolute:7</CellOption></att.Columns>
          <Cell Site="row:1 column:0">
            <Polygon Size="x:7 y:4" BorderColor-bind="self.VisuallyEnabled ? winxpColors.HeaderText : winxpColors.TextDisabled" BackgroundColor-bind="self.VisuallyEnabled ? winxpColors.HeaderText : winxpColors.TextDisabled">
              <att.Points><Point>x:0 y:0</Point><Point>x:3 y:3</Point><Point>x:6 y:0</Point></att.Points>
            </Polygon>
          </Cell>
        </Table>
      </SelectableButtonTemplate>
    </Instance>
  </Instance>
</Folder>
