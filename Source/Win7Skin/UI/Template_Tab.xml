<Folder>
  <Instance name="TabHeaderButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win7skin::TabHeaderButtonTemplate" ref.Styles="res://Win7Skin/Style">
      <ref.Members>
        <![CDATA[
          prop Highlighted: bool = false {}
          prop SelectedRibbonTab: bool = false {}
          prop TabFocused: bool = false {}
          prop Colors : ButtonColors = win7Colors.TabNormal {}
        ]]>
      </ref.Members>
      <SelectableButtonTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren">
        <att.Highlighted-bind>(cast (RibbonTabPage*) self.Context).Highlighted ?? false</att.Highlighted-bind>
        <att.SelectedRibbonTab-bind>self.Selected and (self.Context is RibbonTabPage*)</att.SelectedRibbonTab-bind>
        <att.TabFocused-bind>(cast (TabPage*) self.Context).OwnerTab.Focused ?? false</att.TabFocused-bind>
        <att.Colors-bind>
          self.Selected ? win7Colors.TabSelected :
          self.VisuallyEnabled and self.State != ButtonState::Normal ? win7Colors.TabHovered :
          (self.Context is RibbonTabPage*) ? win7Colors.RibbonButtonNormal : win7Colors.TabNormal
        </att.Colors-bind>
        <SolidBorder Color-bind="self.SelectedRibbonTab ? win7Colors.RibbonBorder : self.Colors.Border"/>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:0">
          <SolidBackground Color-bind="self.SelectedRibbonTab ? win7Colors.RibbonBackgroundTop : self.Colors.Background"/>
        </Bounds>
        <Table AlignmentToParent="left:2 top:2 right:2 bottom:0">
          <att.Rows>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
            <CellOption>composeType:Percentage percentage:0.5</CellOption>
          </att.Rows>
          <att.Columns><CellOption>composeType:Percentage percentage:1.0</CellOption></att.Columns>
          <Cell Site="row:0 column:0"><GradientBackground Direction="Vertical" Color1-bind="self.Colors.G1" Color2-bind="self.Colors.G2"/></Cell>
          <Cell Site="row:1 column:0"><GradientBackground Direction="Vertical" Color1-bind="self.Colors.G3" Color2-bind="self.SelectedRibbonTab ? win7Colors.RibbonBackgroundTop : self.Colors.G4"/></Cell>
        </Table>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:-1" PreferredMinSize="x:0 y:2" Visible-bind="self.Highlighted">
          <SolidBackground Color-bind="self.Selected ? win7Colors.TabHighlightedSelected : self.State != ButtonState::Normal ? win7Colors.TabHighlightedHovered : win7Colors.TabHighlightedBackground"/>
        </Bounds>
        <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1" Visible-bind="self.Selected and self.TabFocused">
          <FocusRectangle/>
        </Bounds>
        <Bounds AlignmentToParent="left:6 top:3 right:6 bottom:3">
          <SolidLabel Color-bind="self.VisuallyEnabled ? self.Colors.Text : win7Colors.TextDisabled" Text-bind="self.Text" Font-bind="self.Font" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Bounds>
      </SelectableButtonTemplate>
    </Instance>
  </Instance>

  <Instance name="TabHeaderTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win7skin::TabHeaderTemplate" ref.Styles="res://Win7Skin/Style">
      <ref.Parameter Name="CurrentTabPage" Class="presentation::controls::GuiTabPage"/>
      <ref.Members>
        <![CDATA[
          prop Commands : ITabCommandExecutor* = null {}
        ]]>
      </ref.Members>
      <ControlTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren">
        <SolidBackground Color-eval="(CurrentTabPage is RibbonTabPage*) ? win7Colors.RibbonTabStrip : win7Colors.GeneralBackground"/>
        <CheckBox ControlTemplate="win7skin::TabHeaderButtonTemplate" AutoFocus="false" AutoSelection="false">
          <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
          <att.Context-ref>CurrentTabPage</att.Context-ref>
          <att.Text-bind>CurrentTabPage.Text</att.Text-bind>
          <att.Alt-bind>CurrentTabPage.Alt</att.Alt-bind>
          <att.Selected-bind>CurrentTabPage.OwnerTab.SelectedPage == CurrentTabPage</att.Selected-bind>
          <ev.Clicked-eval>
            <![CDATA[
              {
                self.Commands.ShowTab(CurrentTabPage.OwnerTab.Pages.IndexOf(CurrentTabPage), true);
              }
            ]]>
          </ev.Clicked-eval>
        </CheckBox>
      </ControlTemplate>
    </Instance>
  </Instance>

  <Instance name="TabTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win7skin::TabTemplate" ref.Styles="res://Win7Skin/Style">
      <ref.Members>
        <![CDATA[
          prop Highlighted: bool = false {}
          prop IsRibbon: bool = false {}

          func UpdateTabHeader() : void
          {
            for (flowItem in header.FlowItems)
            {
              var item = cast (TabHeaderTemplate*) flowItem.Children[0];
              if (item.CurrentTabPage == self.SelectedTabPage)
              {
                flowItem.ExtraMargin = {left:2 top:2 right:2 bottom:0};
                header.MoveChild(flowItem, header.Children.Count - 1);
              }
              else
              {
                flowItem.ExtraMargin = {left:0 top:0 right:0 bottom:-1};
              }
            }
          }
        ]]>
      </ref.Members>
      <RibbonTabTemplate ref.Name="self" ContainerComposition-ref="container" TabOrder="LeftToRight" MinSizeLimitation="LimitToElementAndChildren">
        <ev.SelectedTabPageChanged-eval>
          <![CDATA[
            {
              self.UpdateTabHeader();
            }
          ]]>
        </ev.SelectedTabPageChanged-eval>
        <att.BeforeHeadersContainer-ref>beforeHeadersContainer</att.BeforeHeadersContainer-ref>
        <att.AfterHeadersContainer-ref>afterHeadersContainer</att.AfterHeadersContainer-ref>
        <att.Highlighted-bind>(cast (RibbonTabPage*) self.SelectedTabPage).Highlighted ?? false</att.Highlighted-bind>

        <Table AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <att.Rows>
            <CellOption>composeType:MinSize</CellOption>
            <CellOption>composeType:Percentage percentage:1.0</CellOption>
          </att.Rows>
          <att.Columns>
            <CellOption>composeType:MinSize</CellOption>
            <CellOption>composeType:Percentage percentage:1.0</CellOption>
            <CellOption>composeType:MinSize</CellOption>
          </att.Columns>

          <Cell ref.Name="beforeHeadersContainer" Site="row:0 column:0">
            <SolidBackground Color-bind="self.IsRibbon ? win7Colors.RibbonTabStrip : win7Colors.GeneralBackground"/>
            <SideAligned Direction="Bottom" MaxLength="1">
              <SolidBackground Color-bind="self.IsRibbon ? win7Colors.RibbonBorder : win7Colors.TabNormal.Border"/>
            </SideAligned>
          </Cell>
          <Cell ref.Name="afterHeadersContainer" Site="row:0 column:2">
            <SolidBackground Color-bind="self.IsRibbon ? win7Colors.RibbonTabStrip : win7Colors.GeneralBackground"/>
            <SideAligned Direction="Bottom" MaxLength="1">
              <SolidBackground Color-bind="self.IsRibbon ? win7Colors.RibbonBorder : win7Colors.TabNormal.Border"/>
            </SideAligned>
          </Cell>

          <Cell Site="row:0 column:1">
            <SideAligned Direction="Bottom" MaxLength="1">
              <SolidBackground Color-bind="self.IsRibbon ? win7Colors.RibbonBorder : win7Colors.TabNormal.Border"/>
            </SideAligned>
            <RepeatFlow ref.Name="header" AlignmentToParent="left:0 top:-1 right:0 bottom:0" ExtraMargin="left:2 top:2 right:2 bottom:0">
              <att.ItemTemplate>win7skin::TabHeaderTemplate</att.ItemTemplate>
              <att.ItemSource-bind>self.TabPages</att.ItemSource-bind>
              <ev.ItemInserted-eval>
                <![CDATA[
                  {
                    var flowItem = header.FlowItems[arguments.itemIndex];
                    var item = cast (TabHeaderTemplate*) flowItem.Children[0];
                    item.Commands = self.Commands;
                    self.UpdateTabHeader();
                  }
                ]]>
              </ev.ItemInserted-eval>
              <ev.ItemRemoved-eval>
                <![CDATA[
                  {
                    self.UpdateTabHeader();
                  }
                ]]>
              </ev.ItemRemoved-eval>
            </RepeatFlow>
          </Cell>
          <Cell Site="row:1 column:0 columnSpan:3">
            <SolidBorder Color-bind="self.IsRibbon ? win7Colors.RibbonBorder : win7Colors.TabNormal.Border"/>
            <Bounds AlignmentToParent-bind="{left:1 top:(self.SelectedTabPage is null ? 1 : 0) right:1 bottom:1}">
              <GradientBackground Direction="Vertical" Color1-bind="self.IsRibbon ? win7Colors.RibbonBackgroundTop : win7Colors.TabSelected.Background" Color2-bind="self.IsRibbon ? win7Colors.RibbonBackgroundBottom : win7Colors.TabSelected.Background"/>
            </Bounds>
            <Bounds ref.Name="container" AlignmentToParent="left:1 top:3 right:1 bottom:1"/>
          </Cell>
        </Table>
      </RibbonTabTemplate>
    </Instance>
  </Instance>
  <Instance name="RibbonTabTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="win7skin::RibbonTabTemplate" xmlns:x="win7skin::*">
      <x:TabTemplate IsRibbon="true"/>
    </Instance>
  </Instance>
</Folder>