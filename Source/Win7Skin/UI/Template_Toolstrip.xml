      <ToolstripButtonTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.Colors-bind>not self.VisuallyEnabled ? win7Colors.ToolstripButtonDisabled : self.State == ButtonState::Pressed or self.SubMenuOpening ? win7Colors.ToolstripButtonPressed : self.Selected ? win7Colors.ToolstripButtonSelected : self.State == ButtonState::Active ? win7Colors.ToolstripButtonActive : win7Colors.ToolstripButtonNormal</att.Colors-bind>
