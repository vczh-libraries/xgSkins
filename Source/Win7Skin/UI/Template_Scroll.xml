        <Bounds ref.Name="container" AlignmentToParent="left:1 top:1 right:1 bottom:1">
          <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:-1" PreferredMinSize="y:6">
            <GradientBackground Direction="Vertical" Color1-eval="win7skin::win7Colors.ProgressTrack1" Color2-eval="win7skin::win7Colors.ProgressTrack2"/>
          </Bounds>
          <Bounds AlignmentToParent="left:0 top:6 right:0 bottom:6">
            <GradientBackground Direction="Vertical" Color1-eval="win7skin::win7Colors.ProgressTrack3" Color2-eval="win7skin::win7Colors.ProgressTrack4"/>
          </Bounds>
          <Bounds AlignmentToParent="left:0 top:-1 right:0 bottom:0" PreferredMinSize="y:6">
            <GradientBackground Direction="Vertical" Color1-eval="win7skin::win7Colors.ProgressTrack4" Color2-eval="win7skin::win7Colors.ProgressTrack5"/>
          </Bounds>
          <PartialView>
            <att.WidthPageSize-bind><![CDATA[
              self.Position >= self.TotalSize - self.PageSize ? 1.0 :
              (cast double self.Position) / (self.TotalSize - self.PageSize)
            ]]></att.WidthPageSize-bind>
            <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:-1" PreferredMinSize="y:6">
              <GradientBackground Direction="Vertical" Color1-eval="win7skin::win7Colors.ProgressFill1" Color2-eval="win7skin::win7Colors.ProgressFill2"/>
